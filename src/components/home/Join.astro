---
import { Picture } from 'astro:assets';
import doctor from '../../assets/brand/logo-character.png';
import ContactForm from '../ContactForm.astro';
import { contactEmail } from '../../config/site';
import { t, type Lang, type TranslationKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const benefits: { title: TranslationKey; desc: TranslationKey }[] = [
  { title: 'join_b1_t', desc: 'join_b1_d' },
  { title: 'join_b2_t', desc: 'join_b2_d' },
  { title: 'join_b3_t', desc: 'join_b3_d' },
  { title: 'join_b4_t', desc: 'join_b4_d' },
  { title: 'join_b5_t', desc: 'join_b5_d' },
  { title: 'join_b6_t', desc: 'join_b6_d' },
];
---

<!-- `#contact` se mantiene como ancla para los enlaces antiguos. -->
<section class="section section--tint join" id="join" aria-labelledby="join-title">
  <span id="contact" class="join__anchor"></span>
  <div class="container join__grid">
    <div class="join__copy" data-reveal>
      <h2 class="h2" id="join-title">{t(lang, 'v2_join_title')}</h2>
      <p class="lead">{t(lang, 'v2_join_lead')}</p>

      <h3 class="join__benefits-title">{t(lang, 'join_benefits')}</h3>
      <ul class="join__benefits">
        {
          benefits.map((benefit) => (
            <li>
              <strong>{t(lang, benefit.title)}</strong>
              <span>{t(lang, benefit.desc)}</span>
            </li>
          ))
        }
      </ul>

      <div class="join__mail">
        <Picture
          src={doctor}
          formats={['avif', 'webp']}
          widths={[160, 320]}
          sizes="96px"
          alt=""
          loading="lazy"
          class="join__doctor"
        />
        <p>
          {t(lang, 'contact_question')}<br />
          <a class="link-arrow" href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>
      </div>
    </div>

    <div class="join__form">
      <p class="join__form-note">{t(lang, 'form_subtitle')}</p>
      <ContactForm lang={lang} />
    </div>
  </div>
</section>

<style>
  .join__anchor {
    position: absolute;
    top: 0;
  }

  .join__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .join__copy .lead {
    margin: 1rem 0 2rem;
  }

  .join__benefits-title {
    margin-bottom: 1rem;
    font-size: var(--fs-h3);
  }

  .join__benefits {
    display: grid;
    gap: 1rem;
  }

  .join__benefits li {
    display: grid;
    gap: 0.15rem;
    padding-left: 1.25rem;
    position: relative;
    line-height: 1.45;
  }

  .join__benefits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--c-green);
  }

  .join__benefits span {
    color: var(--c-ink-soft);
    font-size: 1rem;
  }

  .join__mail {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .join__mail p {
    margin: 0;
  }

  .join__mail :global(.join__doctor) {
    width: 6rem;
    height: auto;
  }

  .join__form {
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    border-radius: var(--r-2);
    background-color: var(--c-white);
    box-shadow: var(--shadow-1);
  }

  .join__form-note {
    margin: 0 0 1.5rem;
    color: var(--c-ink-soft);
  }

  @media (max-width: 55rem) {
    .join__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
