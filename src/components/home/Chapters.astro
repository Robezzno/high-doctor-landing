---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import mcclintock from '../../assets/photos/mcclintock.jpg';
import jars from '../../assets/photos/pharmacy-jars.jpg';
import hemp from '../../assets/photos/hemp-field.jpg';
import { t, type Lang, type TranslationKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const newsHref = lang === 'es' ? '/noticias/' : '/en/news/';

interface Chapter {
  id: string;
  title: TranslationKey;
  desc: TranslationKey;
  link: TranslationKey;
  alt: TranslationKey;
  href: string;
  image: ImageMetadata;
  position: string;
  field: string;
}

const chapters: Chapter[] = [
  {
    id: 'research',
    title: 'impact_ch1_t',
    desc: 'impact_ch1_d',
    link: 'impact_ch1_link',
    alt: 'impact_ch1_alt',
    href: '#evidence',
    image: mcclintock,
    position: '40% 30%',
    field: 'var(--c-ink)',
  },
  {
    id: 'education',
    title: 'impact_ch2_t',
    desc: 'impact_ch2_d',
    link: 'impact_ch2_link',
    alt: 'impact_ch2_alt',
    href: newsHref,
    image: jars,
    position: '50% 50%',
    field: 'var(--c-lab)',
  },
  {
    id: 'community',
    title: 'impact_ch3_t',
    desc: 'impact_ch3_d',
    link: 'impact_ch3_link',
    alt: 'impact_ch3_alt',
    href: '#contact',
    image: hemp,
    position: '55% 50%',
    field: '#22261f',
  },
];
---

<!-- Un capítulo por pantalla: cada campo de color nace como un panel con
     margen y crece hasta el borde mientras la fotografía se asienta. -->
<section class="chapters" id="impact" aria-labelledby="impact-title">
  {
    chapters.map((chapter, index) => (
      <article class="chapter" style={`--field:${chapter.field}`} data-chapter>
        <div class="chapter__inner">
          <header class="chapter__head">
            {index === 0 && (
              <h2 class="visually-hidden" id="impact-title">
                {t(lang, 'impact_title')}
              </h2>
            )}
            <h3 class="chapter__title">{t(lang, chapter.title)}</h3>
          </header>
          <figure class="chapter__photo">
            <Picture
              src={chapter.image}
              formats={['avif', 'webp']}
              widths={[480, 760, 1100]}
              sizes="(max-width: 55rem) 80vw, 36vw"
              alt={t(lang, chapter.alt)}
              class="photo"
              loading="lazy"
              style={`object-position:${chapter.position}`}
            />
          </figure>
          <p class="chapter__desc">{t(lang, chapter.desc)}</p>
          <a class="chapter__link link-bar" href={chapter.href}>
            {t(lang, chapter.link)}
          </a>
        </div>
      </article>
    ))
  }
</section>

<style>
  .chapter {
    position: relative;
    min-height: 100svh;
    background-color: var(--field);
    color: var(--c-paper);
    isolation: isolate;
  }

  .chapter__inner {
    display: grid;
    grid-template-columns: 1fr minmax(0, auto) 1fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      'head photo .'
      '. photo .'
      'desc photo link';
    gap: 2rem;
    min-height: 100svh;
    padding: 2rem var(--margin);
  }

  .chapter__head {
    grid-area: head;
  }

  .chapter__title {
    max-width: 22ch;
    font-size: var(--step-lead);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .chapter__photo {
    grid-area: photo;
    align-self: center;
    width: min(36vw, calc((100svh - 8rem) * 0.75));
    aspect-ratio: 3 / 4;
    margin: 0;
    overflow: hidden;
  }

  .chapter__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chapter__desc {
    grid-area: desc;
    align-self: end;
    max-width: 32ch;
    margin: 0;
    font-size: var(--step-body);
    line-height: 1.45;
  }

  .chapter__link {
    grid-area: link;
    align-self: end;
    justify-self: end;
    font-size: var(--step-body);
  }

  .chapter__link:hover {
    color: var(--c-green);
  }

  /* El campo nace con 20 px de margen y la foto un poco más pequeña; al
     entrar en pantalla, el campo llega al borde y la foto se asienta. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-reveal-ready]) .chapter:not(.is-in) {
      clip-path: inset(20px);
    }

    :global(html[data-reveal-ready]) .chapter:not(.is-in) .chapter__photo :global(img) {
      transform: scale(0.92);
    }

    :global(html[data-reveal-ready]) .chapter:not(.is-in) .chapter__inner > :not(.chapter__photo) {
      opacity: 0;
      transform: translateY(16px);
    }

    :global(html[data-reveal-ready]) .chapter {
      clip-path: inset(0);
      transition: clip-path 800ms var(--ease-out);
    }

    :global(html[data-reveal-ready]) .chapter .chapter__photo :global(img) {
      transition: transform 1.1s var(--ease-out);
    }

    :global(html[data-reveal-ready]) .chapter .chapter__inner > :not(.chapter__photo) {
      transition:
        opacity 700ms var(--ease-out) 200ms,
        transform 900ms var(--ease-out) 200ms;
    }
  }

  @media (max-width: 55rem) {
    .chapter__inner {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto auto;
      grid-template-areas:
        'head'
        'photo'
        'desc'
        'link';
      gap: 1.25rem;
      padding-block: 1.5rem 2rem;
    }

    .chapter__title {
      font-size: 1.375rem;
    }

    .chapter__photo {
      justify-self: center;
      width: min(80vw, calc((100svh - 18rem) * 0.75));
    }

    .chapter__link {
      justify-self: start;
    }
  }
</style>
