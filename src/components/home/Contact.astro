---
import { Picture } from 'astro:assets';
import koehler from '../../assets/photos/koehler.jpg';
import ContactForm from '../ContactForm.astro';
import { contactEmail } from '../../config/site';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const newsHref = lang === 'es' ? '/noticias/' : '/en/news/';
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <!-- Una fila de cierre: la frase, una lámina y dos enlaces. -->
    <div class="contact__row" data-reveal>
      <p class="contact__sentence">{t(lang, 'contact_sentence')}</p>
      <figure class="contact__photo">
        <Picture
          src={koehler}
          formats={['avif', 'webp']}
          widths={[200, 400]}
          sizes="170px"
          alt={t(lang, 'hero_alt_plate')}
          class="photo"
          loading="lazy"
        />
      </figure>
      <div class="contact__links">
        <p class="contact__question">{t(lang, 'contact_question')}</p>
        <a class="link-bar contact__link" href={`mailto:${contactEmail}`}>{contactEmail}</a>
        <a class="link-bar contact__link" href={newsHref}>{t(lang, 'contact_news')}</a>
        <p class="contact__note">{t(lang, 'contact_note')}</p>
      </div>
    </div>

    <div class="contact__form-grid">
      <div class="contact__intro" data-reveal>
        <h2 class="h2 contact__title" id="contact-title">{t(lang, 'form_title')}</h2>
        <p class="contact__subtitle">{t(lang, 'form_subtitle')}</p>
      </div>
      <div class="contact__form">
        <ContactForm lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-y);
  }

  .contact__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: start;
    margin-bottom: var(--section-y);
  }

  .contact__sentence {
    grid-column: 1 / 6;
    margin: 0;
    font-size: var(--step-lead);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .contact__photo {
    grid-column: 8 / 10;
    width: min(100%, 170px);
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
  }

  .contact__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }

  .contact__links {
    grid-column: 10 / 13;
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }

  .contact__question {
    margin: 0 0 0.6rem;
    font-size: var(--step-body);
    font-weight: 600;
  }

  .contact__link {
    font-size: var(--step-body);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .contact__link:hover {
    color: var(--c-green-deep);
  }

  .contact__note {
    margin: 0.6rem 0 0;
    font-size: var(--step-small);
    color: var(--c-ink-soft);
  }

  .contact__form-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
    padding: clamp(1.5rem, 4vw, 4rem);
    margin-inline: calc(var(--margin) * -1 + 8px);
    background-color: var(--c-paper-2);
  }

  .contact__intro {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: end;
    margin-bottom: clamp(1rem, 3vw, 2.5rem);
  }

  .contact__intro > .contact__title {
    grid-column: 1 / 9;
  }

  .contact__intro > .contact__subtitle {
    grid-column: 9 / 13;
  }

  .contact__title {
    font-size: var(--step-head);
  }

  .contact__subtitle {
    margin: 0;
    max-width: 32ch;
  }

  .contact__form {
    grid-column: 1 / -1;
  }

  @media (max-width: 55rem) {
    .contact__row {
      grid-template-columns: 6rem 1fr;
      gap: 1.5rem 1rem;
    }

    .contact__sentence {
      grid-column: 1 / -1;
      font-size: clamp(1.375rem, 4.4vw, 2rem);
    }

    .contact__photo {
      grid-column: 1;
      width: 6rem;
    }

    .contact__links {
      grid-column: 2;
    }

    .contact__note {
      grid-column: 1 / -1;
    }

    .contact__form-grid {
      grid-template-columns: 1fr;
      margin-inline: calc(var(--margin) * -1);
    }

    .contact__intro,
    .contact__form {
      grid-column: 1;
    }

    .contact__intro {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .contact__intro > .contact__title,
    .contact__intro > .contact__subtitle {
      grid-column: 1;
    }
  }
</style>
