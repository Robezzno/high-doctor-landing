---
import { Picture } from 'astro:assets';
import berlin from '../../assets/photos/berlin.jpg';
import { featuredEvent } from '../../data/event';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const date = featuredEvent.date
  ? new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' }).format(
      new Date(`${featuredEvent.date}T12:00:00`),
    )
  : t(lang, 'ev_tba');
---

<section class="section event" id="mary-jane" aria-labelledby="event-title">
  <div class="container">
    <div class="event__card" data-reveal>
      <figure class="event__photo">
        <Picture
          src={berlin}
          formats={['avif', 'webp']}
          widths={[480, 760, 1100]}
          sizes="(max-width: 55rem) 100vw, 45vw"
          alt={t(lang, 'mj_alt_1')}
          loading="lazy"
        />
      </figure>
      <div class="event__copy">
        <h2 class="event__title" id="event-title">{t(lang, 'v2_event_title')}</h2>
        <p>{t(lang, 'mj_desc')}</p>
        <dl class="event__facts">
          <div>
            <dt>{t(lang, 'ev_date')}</dt>
            <dd>{date}</dd>
          </div>
          <div>
            <dt>{t(lang, 'ev_city')}</dt>
            <dd>{featuredEvent.city}</dd>
          </div>
        </dl>
        <a class="btn btn--accent" href="#join">
          {t(lang, 'mj_btn')}
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path
              d="M2 9h12M10 4l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .event {
    padding-top: 0;
  }

  .event__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    overflow: hidden;
    border-radius: var(--r-2);
    background-color: var(--c-ink);
    color: var(--c-white);
    --focus-color: var(--c-white);
  }

  .event__photo {
    margin: 0;
    min-height: 20rem;
  }

  .event__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event__copy {
    display: grid;
    gap: 1rem;
    align-content: center;
    justify-items: start;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }

  .event__title {
    font-size: var(--fs-h2);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
  }

  .event__copy > p {
    margin: 0;
    max-width: 32rem;
    color: var(--c-paper-muted);
  }

  .event__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin: 0.5rem 0;
  }

  .event__facts dt {
    font-size: var(--fs-small);
    color: var(--c-paper-muted);
  }

  .event__facts dd {
    margin: 0.15rem 0 0;
    font-size: 1.125rem;
    font-weight: 700;
  }

  @media (max-width: 55rem) {
    .event__card {
      grid-template-columns: 1fr;
    }

    .event__photo {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }
</style>
