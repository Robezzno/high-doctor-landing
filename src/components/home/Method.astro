---
import { t, type Lang, type TranslationKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const scale: { letter: string; def: TranslationKey }[] = [
  { letter: 'A', def: 'v2_def_a' },
  { letter: 'B', def: 'v2_def_b' },
  { letter: 'C', def: 'v2_def_c' },
  { letter: 'D', def: 'v2_def_d' },
  { letter: 'E', def: 'v2_def_e' },
];

const steps: { title: TranslationKey; desc: TranslationKey }[] = [
  { title: 'process_step1_t', desc: 'process_step1_d' },
  { title: 'process_step2_t', desc: 'process_step2_d' },
  { title: 'process_step3_t', desc: 'process_step3_d' },
];
---

<!-- Cómo se pone la nota: a la izquierda el método, a la derecha la escala
     como la tabla de una etiqueta. -->
<section class="section section--tint method" id="method" aria-labelledby="method-title">
  <div class="container method__grid">
    <div class="method__copy" data-reveal>
      <h2 class="h2" id="method-title">{t(lang, 'v2_scale_title')}</h2>
      <p class="lead">{t(lang, 'v2_scale_lead')}</p>
      <ol class="steps">
        {
          steps.map((step) => (
            <li class="steps__item">
              <h3 class="steps__title">{t(lang, step.title)}</h3>
              <p>{t(lang, step.desc)}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="scale" data-reveal>
      <p class="scale__title">{t(lang, 'v2_grade_label')}</p>
      <dl class="scale__list">
        {
          scale.map((row) => (
            <div class="scale__row">
              <dt class={`scale__letter scale__letter--${row.letter.toLowerCase()}`}>{row.letter}</dt>
              <dd>{t(lang, row.def)}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .method__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .method__copy .lead {
    max-width: 38rem;
    margin: 1rem 0 2.5rem;
  }

  .steps {
    display: grid;
    gap: 1.5rem;
    counter-reset: step;
  }

  .steps__item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 1rem;
    counter-increment: step;
  }

  /* El orden importa (cada paso depende del anterior): una lista real. */
  .steps__item::before {
    content: counter(step);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--c-ink);
    color: var(--c-white);
    font-weight: 700;
  }

  .steps__title {
    align-self: center;
    font-size: var(--fs-h3);
  }

  .steps__item p {
    margin: 0.35rem 0 0;
    max-width: 34rem;
    color: var(--c-ink-soft);
  }

  /* La escala, como la tabla de una etiqueta. */
  .scale {
    padding: 1.5rem;
    border-radius: var(--r-2);
    background-color: var(--c-white);
    box-shadow: var(--shadow-1);
  }

  .scale__title {
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 6px solid var(--c-ink);
    font-size: var(--fs-h3);
    font-weight: 800;
  }

  .scale__list {
    display: grid;
  }

  .scale__row {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    align-items: center;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--c-paper-3);
  }

  .scale__row:last-child {
    border-bottom: 0;
  }

  .scale__letter {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 10px;
    font-size: 1.5rem;
    font-weight: 800;
  }

  .scale__letter--a {
    background-color: var(--grade-a);
    color: var(--grade-a-ink);
  }

  .scale__letter--b {
    background-color: var(--grade-b);
    color: var(--grade-b-ink);
  }

  .scale__letter--c {
    background-color: var(--grade-c);
    color: var(--grade-c-ink);
  }

  .scale__letter--d {
    background-color: var(--grade-d);
    color: var(--grade-d-ink);
  }

  .scale__letter--e {
    background-color: var(--grade-e);
    color: var(--grade-e-ink);
  }

  .scale__row dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }

  @media (max-width: 55rem) {
    .method__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
