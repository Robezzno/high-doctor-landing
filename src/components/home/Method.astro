---
import { t, type Lang, type TranslationKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const scale: { letter: string; def: TranslationKey }[] = [
  { letter: 'A', def: 'v2_def_a' },
  { letter: 'B', def: 'v2_def_b' },
  { letter: 'C', def: 'v2_def_c' },
  { letter: 'D', def: 'v2_def_d' },
  { letter: 'E', def: 'v2_def_e' },
];

const steps: { title: TranslationKey; desc: TranslationKey }[] = [
  { title: 'process_step1_t', desc: 'process_step1_d' },
  { title: 'process_step2_t', desc: 'process_step2_d' },
  { title: 'process_step3_t', desc: 'process_step3_d' },
];
---

<!-- Cómo se pone la nota: a la izquierda el método, a la derecha la escala
     como la tabla de una etiqueta. -->
<section class="section section--tint method" id="method" aria-labelledby="method-title">
  <div class="container method__grid">
    <div class="method__copy" data-reveal>
      <h2 class="h2" id="method-title">{t(lang, 'v2_scale_title')}</h2>
      <p class="lead">{t(lang, 'v2_scale_lead')}</p>
    </div>

    <div class="scale" data-reveal>
      <p class="scale__title">{t(lang, 'v2_grade_label')}</p>
      <dl class="scale__list">
        {
          scale.map((row) => (
            <div class="scale__row">
              <dt class={`scale__letter scale__letter--${row.letter.toLowerCase()}`}>{row.letter}</dt>
              <dd>{t(lang, row.def)}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ol class="steps" data-reveal>
      {
        steps.map((step) => (
          <li class="steps__item">
            <h3 class="steps__title">{t(lang, step.title)}</h3>
            <p>{t(lang, step.desc)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .method__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .method__copy .lead {
    max-width: 38rem;
    margin-top: 1rem;
  }

  /* Los tres pasos, en fila: el orden importa, así que es una lista real. */
  .steps {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    counter-reset: step;
  }

  .steps__item {
    padding-top: 1rem;
    border-top: 1px solid var(--c-line);
    counter-increment: step;
  }

  .steps__item::before {
    content: counter(step, decimal-leading-zero);
    display: block;
    margin-bottom: 0.75rem;
    font-size: var(--fs-small);
    font-weight: var(--fw-head);
    font-variant-numeric: tabular-nums;
    color: var(--c-green-ink);
  }

  .steps__title {
    font-size: var(--fs-h3);
  }

  .steps__item p {
    margin: 0.4rem 0 0;
    color: var(--c-ink-soft);
  }

  /* La escala, como la tabla nutricional de una etiqueta: filete grueso arriba. */
  .scale {
    border-top: 6px solid var(--c-ink);
  }

  .scale__title {
    margin: 0;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--c-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-strong);
  }

  .scale__list {
    display: grid;
  }

  .scale__row {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 1rem;
    align-items: center;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--c-line);
  }

  .scale__letter {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 6px;
    font-size: 1.125rem;
    font-weight: var(--fw-grade);
  }

  .scale__letter--a {
    background-color: var(--grade-a);
    color: var(--grade-a-ink);
  }

  .scale__letter--b {
    background-color: var(--grade-b);
    color: var(--grade-b-ink);
  }

  .scale__letter--c {
    background-color: var(--grade-c);
    color: var(--grade-c-ink);
  }

  .scale__letter--d {
    background-color: var(--grade-d);
    color: var(--grade-d-ink);
  }

  .scale__letter--e {
    background-color: var(--grade-e);
    color: var(--grade-e-ink);
  }

  .scale__row dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  @media (max-width: 55rem) {
    .method__grid,
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
