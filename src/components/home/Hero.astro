---
import { Picture } from 'astro:assets';
// Busto sin el rótulo «HIGH DOCTOR» (el logo ya está en el menú).
import doctor from '../../assets/brand/doctor-bust.png';
import { evidenceSources, evidenceTopics, gradeOf, type EvidenceTopic } from '../../data/evidence';
import { t, type Lang, type TranslationKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const letters = ['A', 'B', 'C', 'D', 'E'] as const;
const sayKey = (letter: string) => `v2_doc_${letter.toLowerCase()}` as TranslationKey;
const levelName = (topic: EvidenceTopic) => t(lang, `evd_lvl_${topic.level}` as TranslationKey);
const titleOf = (topic: EvidenceTopic) => t(lang, `evd_${topic.id}_t` as TranslationKey);
const shortSource = (topic: EvidenceTopic) => evidenceSources[topic.source].short;

const first = evidenceTopics[0];
const firstGrade = gradeOf(first.level);

const options = evidenceTopics.map((topic) => {
  const grade = gradeOf(topic.level);
  return {
    id: topic.id,
    title: titleOf(topic),
    grade,
    level: levelName(topic),
    group: topic.group,
    say: t(lang, sayKey(grade)),
    source: shortSource(topic),
  };
});

const groups = [
  { id: 'use', label: t(lang, 'evd_group_use') },
  { id: 'risk', label: t(lang, 'evd_group_risk') },
] as const;
---

<section class="hero" aria-labelledby="hero-title" data-hero-explorer>
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">{t(lang, 'v2_hero_h1')}</h1>
      <p class="hero__sub">{t(lang, 'v2_hero_sub')}</p>
    </div>

      <!-- La etiqueta: eliges tema y la nota cambia aquí mismo. -->
      <div class="label">
        <label class="label__ask" for="hero-topic">{t(lang, 'v2_hero_ask')}</label>
        <div class="label__select">
          <select id="hero-topic" data-topic-select>
            {
              groups.map((group) => (
                <optgroup label={group.label}>
                  {options
                    .filter((o) => o.group === group.id)
                    .map((o) => (
                      <option
                        value={o.id}
                        data-grade={o.grade}
                        data-level={o.level}
                        data-say={o.say}
                        data-source={o.source}
                      >
                        {o.title}
                      </option>
                    ))}
                </optgroup>
              ))
            }
          </select>
          <svg class="label__chevron" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M3.5 6l4.5 4.5L12.5 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>

        <div class="label__panel" aria-live="polite">
          <p class="label__caption">{t(lang, 'v2_grade_label')}</p>
          <div class="verdict">
            <p class="verdict__grade">
              <span class="visually-hidden">{t(lang, 'v2_grade_label')}: </span>
              <span data-verdict-grade>{firstGrade}</span>
            </p>
            <div class="verdict__text">
              <p class="verdict__level" data-verdict-level>{levelName(first)}</p>
              <p class="label__source">
                {t(lang, 'evd_source')}: <span data-verdict-source>{shortSource(first)}</span>
              </p>
              <a class="link-arrow label__more" href={`#evd-${first.id}`} data-verdict-link>
                {t(lang, 'v2_see_verdict')}
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M2 8h11M9 3.5 13.5 8 9 12.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </a>
            </div>
          </div>
          <!-- Escala A–E: dónde cae la nota. -->
          <ol class="strip" aria-hidden="true">
            {
              letters.map((letter) => (
                <li
                  class:list={[
                    'strip__cell',
                    `strip__cell--${letter.toLowerCase()}`,
                    { 'is-on': letter === firstGrade },
                  ]}
                  data-letter={letter}
                >
                  <span class="strip__letter">{letter}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <p class="label__legend">{t(lang, 'v2_grade_legend')}</p>
      </div>

    <figure class="hero__doctor">
      <p class="bubble" data-bubble aria-live="polite">{t(lang, sayKey(firstGrade))}</p>
      <Picture
        src={doctor}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[240, 400, 640]}
        sizes="(max-width: 60rem) 34vw, 22rem"
        alt={t(lang, 'mascot_alt')}
        loading="eager"
        fetchpriority="high"
        class="hero__doctor-img"
      />
    </figure>
  </div>
</section>

<script>
  /** Selector del hero: cambia la nota, la frase del doctor y la fuente. */
  function initHeroExplorer(): void {
    const root = document.querySelector<HTMLElement>('[data-hero-explorer]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const select = root.querySelector<HTMLSelectElement>('[data-topic-select]');
    const cells = Array.from(root.querySelectorAll<HTMLElement>('[data-letter]'));
    const grade = root.querySelector<HTMLElement>('[data-verdict-grade]');
    const level = root.querySelector<HTMLElement>('[data-verdict-level]');
    const source = root.querySelector<HTMLElement>('[data-verdict-source]');
    const link = root.querySelector<HTMLAnchorElement>('[data-verdict-link]');
    const bubble = root.querySelector<HTMLElement>('[data-bubble]');
    if (!select || !grade || !level || !source || !link || !bubble) return;

    const update = (): void => {
      const option = select.selectedOptions[0];
      if (!option) return;
      const letter = option.dataset.grade ?? '';
      for (const cell of cells) cell.classList.toggle('is-on', cell.dataset.letter === letter);
      grade.textContent = letter;
      level.textContent = option.dataset.level ?? '';
      source.textContent = option.dataset.source ?? '';
      link.href = `#evd-${option.value}`;
      bubble.textContent = option.dataset.say ?? '';
      bubble.classList.remove('is-new');
      void bubble.offsetWidth;
      bubble.classList.add('is-new');
    };

    select.addEventListener('change', update);

    // El enlace abre la ficha completa del tema en la rejilla.
    link.addEventListener('click', () => {
      const target = document.getElementById(link.hash.slice(1));
      if (target instanceof HTMLDetailsElement) target.open = true;
    });
  }

  document.addEventListener('astro:page-load', initHeroExplorer);
</script>

<style>
  .hero {
    padding-block: clamp(2rem, 1rem + 3vw, 4.5rem) var(--section-y);
  }

  /* Escritorio: titular y doctor a la izquierda, la etiqueta a la derecha,
     todo en la primera pantalla. */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    grid-template-areas:
      'copy label'
      'doctor label';
    gap: 2rem clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .hero__copy {
    grid-area: copy;
  }

  .label {
    grid-area: label;
    align-self: center;
  }

  .hero__doctor {
    grid-area: doctor;
  }

  .hero__title {
    max-width: 18ch;
    font-size: var(--fs-h1);
    font-weight: var(--fw-head);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    font-size-adjust: cap-height from-font;
  }

  .hero__sub {
    max-width: 32rem;
    margin: 1.5rem 0 0;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--c-ink-soft);
  }

  /* ---------------------------------------------------------- La etiqueta */
  /* La única sombra de la página: la etiqueta, como un envase sobre la mesa. */
  .label {
    max-width: 36rem;
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    border: 1px solid var(--c-line);
    border-radius: var(--r-2);
    background-color: var(--c-white);
    box-shadow: var(--shadow-2);
  }

  .label__ask {
    display: block;
    margin-bottom: 0.5rem;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .label__select {
    position: relative;
  }

  .label__select select {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 3rem 0.75rem 1rem;
    border: 1px solid var(--c-ink);
    border-radius: var(--r-1);
    background-color: var(--c-white);
    font-size: 1.125rem;
    font-weight: var(--fw-head);
    appearance: none;
    cursor: pointer;
    transition: border-color var(--dur-fast) linear;
  }

  .label__select select:hover {
    border-color: var(--c-green-ink);
  }

  .label__chevron {
    position: absolute;
    top: 50%;
    right: 1rem;
    translate: 0 -50%;
    pointer-events: none;
  }

  /* Select a medida donde el navegador lo permite; si no, el nativo de arriba. */
  @supports (appearance: base-select) {
    .label__select select,
    .label__select select::picker(select) {
      appearance: base-select;
    }

    .label__select select {
      display: flex;
      align-items: center;
    }

    /* Mantenemos nuestro chevrón (mismo trazo que el resto de iconos). */
    .label__select select::picker-icon {
      display: none;
    }

    .label__chevron {
      transition: rotate var(--dur-base) var(--ease-out);
    }

    .label__select:has(select:open) .label__chevron {
      rotate: 180deg;
    }

    .label__select select::picker(select) {
      margin-top: 0.375rem;
      padding: 0.375rem;
      border: 1px solid var(--c-line);
      border-radius: var(--r-1);
      background-color: var(--c-white);
      box-shadow: var(--shadow-2);
    }

    .label__select optgroup {
      padding-top: 0.25rem;
      font-size: var(--fs-small);
      font-weight: var(--fw-head);
      color: var(--c-ink-faint);
    }

    .label__select option {
      padding: 0.5rem 0.75rem;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: var(--fw-regular);
      color: var(--c-ink);
      cursor: pointer;
    }

    .label__select option:hover,
    .label__select option:focus-visible {
      background-color: var(--c-paper-2);
    }

    .label__select option::checkmark {
      color: var(--c-green-ink);
    }
  }

  .label__panel {
    margin-top: 1.5rem;
  }

  .label__caption {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  /* La nota: la letra es lo más grande de la página. */
  .verdict {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    align-items: center;
  }

  .verdict__grade {
    margin: 0;
    font-size: var(--fs-grade);
    font-weight: var(--fw-grade);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--c-ink);
  }

  .verdict__text {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }

  .verdict__level {
    margin: 0;
    font-size: var(--fs-h2);
    font-weight: var(--fw-head);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .label__source {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .label__more {
    margin-top: 0.35rem;
    font-size: var(--fs-small);
  }

  /* Escala fina A–E: la marca activa crece; el resto se queda en filete. */
  .strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
    margin-top: 1.25rem;
  }

  .strip__cell {
    display: grid;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: var(--fw-head);
    color: var(--c-ink-faint);
  }

  .strip__cell::before {
    content: '';
    display: block;
    height: 6px;
    border-radius: 3px;
    background-color: var(--strip-color);
    opacity: 0.35;
    transform-origin: bottom;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .strip__cell--a { --strip-color: var(--grade-a); }
  .strip__cell--b { --strip-color: var(--grade-b); }
  .strip__cell--c { --strip-color: var(--grade-c); }
  .strip__cell--d { --strip-color: var(--grade-d); }
  .strip__cell--e { --strip-color: var(--grade-e); }

  .strip__cell.is-on {
    color: var(--c-ink);
    font-weight: var(--fw-strong);
  }

  .strip__cell.is-on::before {
    opacity: 1;
    transform: scaleY(1.67);
  }

  .label__legend {
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--c-paper-3);
    font-size: var(--fs-small);
    color: var(--c-ink-faint);
  }

  /* ---------------------------------------------------------- El doctor */
  /* El doctor habla desde el lado del titular: bocadillo a su izquierda. */
  .hero__doctor {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
  }

  .hero__doctor :global(.hero__doctor-img) {
    width: 100%;
    max-width: 15rem;
    height: auto;
    /* El busto se funde con el suelo en vez de cortarse en seco. */
    mask-image: linear-gradient(to bottom, #000 82%, transparent);
  }

  .bubble {
    position: relative;
    max-width: 22rem;
    margin: 0;
    padding: 0.875rem 1.125rem;
    border-radius: 16px;
    background-color: var(--c-ink);
    color: var(--c-white);
    font-size: 1rem;
    font-weight: var(--fw-head);
    line-height: 1.4;
  }

  .bubble::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -12px;
    width: 20px;
    height: 20px;
    translate: 0 -50%;
    background-color: var(--c-ink);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bubble.is-new {
      animation: bubble-in 300ms var(--ease-out);
    }

    @keyframes bubble-in {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip__cell::before {
      transition: none;
    }
  }

  /* ---------------------------------------------------------- Teléfono */
  @media (max-width: 60rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'doctor'
        'copy'
        'label';
      gap: 1.5rem;
    }

    .hero__doctor {
      grid-template-columns: minmax(0, 1fr) 7.5rem;
    }

    .bubble {
      max-width: none;
      font-size: 0.9375rem;
    }

    .hero__doctor :global(.hero__doctor-img) {
      max-width: 100%;
    }

    .hero__sub {
      margin-top: 1rem;
    }
  }
</style>
