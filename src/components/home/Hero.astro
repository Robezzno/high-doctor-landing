---
import { Picture } from 'astro:assets';
import doctor from '../../assets/brand/logo-character.png';
import { evidenceSources, evidenceTopics, gradeOf, type EvidenceTopic } from '../../data/evidence';
import { t, type Lang, type TranslationKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const letters = ['A', 'B', 'C', 'D', 'E'] as const;
const sayKey = (letter: string) => `v2_doc_${letter.toLowerCase()}` as TranslationKey;
const levelName = (topic: EvidenceTopic) => t(lang, `evd_lvl_${topic.level}` as TranslationKey);
const titleOf = (topic: EvidenceTopic) => t(lang, `evd_${topic.id}_t` as TranslationKey);
const shortSource = (topic: EvidenceTopic) => evidenceSources[topic.source].short;

const first = evidenceTopics[0];
const firstGrade = gradeOf(first.level);

const options = evidenceTopics.map((topic) => {
  const grade = gradeOf(topic.level);
  return {
    id: topic.id,
    title: titleOf(topic),
    grade,
    level: levelName(topic),
    group: topic.group,
    say: t(lang, sayKey(grade)),
    source: shortSource(topic),
  };
});

const groups = [
  { id: 'use', label: t(lang, 'evd_group_use') },
  { id: 'risk', label: t(lang, 'evd_group_risk') },
] as const;
---

<section class="hero" aria-labelledby="hero-title" data-hero-explorer>
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">{t(lang, 'v2_hero_h1')}</h1>
      <p class="hero__sub">{t(lang, 'v2_hero_sub')}</p>

      <!-- La etiqueta: eliges tema y la nota cambia aquí mismo. -->
      <div class="label">
        <label class="label__ask" for="hero-topic">{t(lang, 'v2_hero_ask')}</label>
        <div class="label__select">
          <select id="hero-topic" data-topic-select>
            {
              groups.map((group) => (
                <optgroup label={group.label}>
                  {options
                    .filter((o) => o.group === group.id)
                    .map((o) => (
                      <option
                        value={o.id}
                        data-grade={o.grade}
                        data-level={o.level}
                        data-say={o.say}
                        data-source={o.source}
                      >
                        {o.title}
                      </option>
                    ))}
                </optgroup>
              ))
            }
          </select>
          <svg class="label__chevron" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M3.5 6l4.5 4.5L12.5 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>

        <div class="label__panel" aria-live="polite">
          <p class="label__caption">{t(lang, 'v2_grade_label')}</p>
          <ol class="strip" aria-hidden="true">
            {
              letters.map((letter) => (
                <li
                  class:list={[
                    'strip__cell',
                    `strip__cell--${letter.toLowerCase()}`,
                    { 'is-on': letter === firstGrade },
                  ]}
                  data-letter={letter}
                >
                  {letter}
                </li>
              ))
            }
          </ol>
          <p class="label__verdict">
            <span class="visually-hidden">{t(lang, 'v2_grade_label')}: </span>
            <span data-verdict-grade>{firstGrade}</span>
            <span aria-hidden="true">·</span>
            <span data-verdict-level>{levelName(first)}</span>
          </p>
          <p class="label__source">
            {t(lang, 'evd_source')}: <span data-verdict-source>{shortSource(first)}</span>
          </p>
          <a class="link-arrow label__more" href={`#evd-${first.id}`} data-verdict-link>
            {t(lang, 'v2_see_verdict')}
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M2 8h11M9 3.5 13.5 8 9 12.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        <p class="label__legend">{t(lang, 'v2_grade_legend')}</p>
      </div>
    </div>

    <figure class="hero__doctor">
      <p class="bubble" data-bubble aria-live="polite">{t(lang, sayKey(firstGrade))}</p>
      <Picture
        src={doctor}
        formats={['avif', 'webp']}
        widths={[280, 480, 720]}
        sizes="(max-width: 60rem) 40vw, 30rem"
        alt={t(lang, 'mascot_alt')}
        loading="eager"
        fetchpriority="high"
        class="hero__doctor-img"
      />
    </figure>
  </div>
</section>

<script>
  /** Selector del hero: cambia la nota, la frase del doctor y la fuente. */
  function initHeroExplorer(): void {
    const root = document.querySelector<HTMLElement>('[data-hero-explorer]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const select = root.querySelector<HTMLSelectElement>('[data-topic-select]');
    const cells = Array.from(root.querySelectorAll<HTMLElement>('[data-letter]'));
    const grade = root.querySelector<HTMLElement>('[data-verdict-grade]');
    const level = root.querySelector<HTMLElement>('[data-verdict-level]');
    const source = root.querySelector<HTMLElement>('[data-verdict-source]');
    const link = root.querySelector<HTMLAnchorElement>('[data-verdict-link]');
    const bubble = root.querySelector<HTMLElement>('[data-bubble]');
    if (!select || !grade || !level || !source || !link || !bubble) return;

    const update = (): void => {
      const option = select.selectedOptions[0];
      if (!option) return;
      const letter = option.dataset.grade ?? '';
      for (const cell of cells) cell.classList.toggle('is-on', cell.dataset.letter === letter);
      grade.textContent = letter;
      level.textContent = option.dataset.level ?? '';
      source.textContent = option.dataset.source ?? '';
      link.href = `#evd-${option.value}`;
      bubble.textContent = option.dataset.say ?? '';
      bubble.classList.remove('is-new');
      void bubble.offsetWidth;
      bubble.classList.add('is-new');
    };

    select.addEventListener('change', update);

    // El enlace abre la ficha completa del tema en la rejilla.
    link.addEventListener('click', () => {
      const target = document.getElementById(link.hash.slice(1));
      if (target instanceof HTMLDetailsElement) target.open = true;
    });
  }

  document.addEventListener('astro:page-load', initHeroExplorer);
</script>

<style>
  .hero {
    padding-block: clamp(1.5rem, 0.5rem + 3vw, 3.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
    background-color: var(--c-paper-2);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: center;
  }

  .hero__title {
    max-width: 24ch;
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .hero__sub {
    max-width: 34rem;
    margin: 1.25rem 0 2rem;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--c-ink-soft);
  }

  /* ---------------------------------------------------------- La etiqueta */
  .label {
    max-width: 36rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--r-2);
    background-color: var(--c-white);
    box-shadow: var(--shadow-2);
  }

  .label__ask {
    display: block;
    margin-bottom: 0.6rem;
    font-weight: 500;
  }

  .label__select {
    position: relative;
  }

  .label__select select {
    width: 100%;
    min-height: 56px;
    padding: 0.75rem 3rem 0.75rem 1rem;
    border: 2px solid var(--c-ink);
    border-radius: var(--r-1);
    background-color: var(--c-white);
    font-size: 1.125rem;
    font-weight: 500;
    appearance: none;
    cursor: pointer;
    transition: border-color var(--dur-fast) linear;
  }

  .label__select select:hover {
    border-color: var(--c-green-ink);
  }

  .label__chevron {
    position: absolute;
    top: 50%;
    right: 1rem;
    translate: 0 -50%;
    pointer-events: none;
  }

  .label__panel {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'caption caption'
      'strip strip'
      'verdict verdict'
      'source more';
    gap: 0.5rem 1rem;
    align-items: center;
    margin-top: 1.25rem;
  }

  .label__caption {
    grid-area: caption;
    margin: 0;
    font-size: var(--fs-small);
    font-weight: 700;
  }

  /* Tira A–E: la letra activa crece y sale de la tira. */
  .strip {
    grid-area: strip;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    height: 5.5rem;
    padding: 0 0.6rem;
    border-radius: var(--r-2);
    background-color: var(--c-paper-2);
  }

  .strip__cell {
    display: grid;
    place-items: center;
    height: 3rem;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    transition:
      transform var(--dur-slow) var(--ease-spring),
      height var(--dur-slow) var(--ease-spring),
      font-size var(--dur-slow) var(--ease-spring),
      box-shadow var(--dur-base) var(--ease-out);
  }

  .strip__cell:first-child {
    border-radius: 10px 0 0 10px;
  }

  .strip__cell:last-child {
    border-radius: 0 10px 10px 0;
  }

  .strip__cell--a {
    background-color: var(--grade-a);
    color: var(--grade-a-ink);
  }

  .strip__cell--b {
    background-color: var(--grade-b);
    color: var(--grade-b-ink);
  }

  .strip__cell--c {
    background-color: var(--grade-c);
    color: var(--grade-c-ink);
  }

  .strip__cell--d {
    background-color: var(--grade-d);
    color: var(--grade-d-ink);
  }

  .strip__cell--e {
    background-color: var(--grade-e);
    color: var(--grade-e-ink);
  }

  .strip__cell.is-on {
    position: relative;
    z-index: 1;
    height: 4.6rem;
    border: 3px solid var(--c-white);
    border-radius: 12px;
    font-size: 2.5rem;
    transform: scale(1.1);
    box-shadow: var(--shadow-2);
  }

  .label__verdict {
    grid-area: verdict;
    display: flex;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    font-size: var(--fs-h3);
    font-weight: 700;
  }

  .label__source {
    grid-area: source;
    margin: 0;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .label__more {
    grid-area: more;
    justify-self: end;
    font-size: var(--fs-small);
  }

  .label__legend {
    margin: 1rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--c-paper-3);
    font-size: var(--fs-small);
    color: var(--c-ink-faint);
  }

  /* ---------------------------------------------------------- El doctor */
  .hero__doctor {
    position: relative;
    margin: 0;
    padding-top: 6.5rem;
  }

  .hero__doctor :global(.hero__doctor-img) {
    width: 100%;
    max-width: 30rem;
    height: auto;
    margin-inline: auto;
    filter: drop-shadow(0 22px 26px rgb(0 12 60 / 18%));
  }

  .bubble {
    position: absolute;
    top: 0;
    left: 8%;
    right: 4%;
    z-index: 1;
    margin: 0;
    padding: 1rem 1.25rem;
    border-radius: 18px;
    background-color: var(--c-ink);
    color: var(--c-white);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .bubble::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 46%;
    width: 24px;
    height: 24px;
    background-color: var(--c-ink);
    clip-path: polygon(0 0, 100% 0, 30% 100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bubble.is-new {
      animation: bubble-in 420ms var(--ease-spring);
    }

    @keyframes bubble-in {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.96);
      }
    }

    .hero__doctor :global(.hero__doctor-img) {
      animation: float 5s ease-in-out infinite alternate;
    }

    @keyframes float {
      to {
        transform: translateY(-10px) rotate(-1deg);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip__cell {
      transition: none;
    }
  }

  /* ---------------------------------------------------------- Teléfono */
  @media (max-width: 60rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__doctor {
      order: -1;
      display: grid;
      grid-template-columns: 1fr 38%;
      align-items: center;
      gap: 0.75rem;
      padding-top: 0;
    }

    .bubble {
      position: relative;
      inset: auto;
      font-size: 0.9375rem;
    }

    .bubble::after {
      bottom: auto;
      top: 40%;
      left: auto;
      right: -14px;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
    }

    .hero__doctor :global(.hero__doctor-img) {
      max-width: 100%;
    }

    .hero__title {
      max-width: none;
      font-size: clamp(2rem, 1.2rem + 3.6vw, 2.75rem);
    }

    .hero__sub {
      margin: 1rem 0 1.5rem;
    }

    .strip {
      height: 4.75rem;
      padding: 0 0.4rem;
    }

    .strip__cell {
      height: 2.6rem;
      font-size: 1.25rem;
    }

    .strip__cell.is-on {
      height: 4rem;
      font-size: 2rem;
    }

    .label__panel {
      grid-template-areas:
        'caption caption'
        'strip strip'
        'verdict verdict'
        'source source'
        'more more';
    }

    .label__more {
      justify-self: start;
    }
  }
</style>
