---
import { evidenceSources, evidenceTopics, gradeOf, type EvidenceTopic } from '../../data/evidence';
import { t, type Lang, type TranslationKey } from '../../i18n';
import { evidenceContent, evidenceHubPath, evidenceTopicPath } from '../../lib/evidence';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const k = (topic: EvidenceTopic, part: 't' | 'f' | 'm') => `evd_${topic.id}_${part}` as TranslationKey;
const levelName = (topic: EvidenceTopic) => t(lang, `evd_lvl_${topic.level}` as TranslationKey);

const groups = [
  { id: 'use', title: t(lang, 'evd_group_use') },
  { id: 'risk', title: t(lang, 'evd_group_risk') },
] as const;

// Dentro de cada grupo, de más certeza (A) a menos (E): se lee como una escala.
const byGrade = (a: EvidenceTopic, b: EvidenceTopic) => gradeOf(a.level).localeCompare(gradeOf(b.level));
---

<!-- Todas las notas: cada tema es una fila de la etiqueta que se despliega
     (details nativo: funciona sin JavaScript, con teclado y con buscar en la página).
     No es exclusivo a propósito: así se pueden comparar dos temas abiertos. -->
<section class="section grades" id="evidence" aria-labelledby="grades-title">
  <div class="container">
    <div class="head" data-reveal>
      <h2 id="grades-title">{t(lang, 'v2_grid_title')}</h2>
      <p>{t(lang, 'v2_grid_lead')}</p>
    </div>

    {
      groups.map((group) => (
        <div class="grades__group" aria-labelledby={`grades-${group.id}`} role="group">
          <h3 class="grades__group-title" id={`grades-${group.id}`}>
            {group.title}
          </h3>
          <ul class="grades__list" data-reveal>
            {evidenceTopics
              .filter((topic) => topic.group === group.id)
              .sort(byGrade)
              .map((topic) => {
                const grade = gradeOf(topic.level);
                const source = evidenceSources[topic.source];
                return (
                  <li>
                    <details class="row" id={`evd-${topic.id}`}>
                      <summary class="row__summary">
                        <span class={`grade grade--${grade.toLowerCase()}`} aria-hidden="true">
                          {grade}
                        </span>
                        <span class="row__title">{t(lang, k(topic, 't'))}</span>
                        <span class="row__level">
                          <span class="visually-hidden">{t(lang, 'v2_grade_label')}: {grade}, </span>
                          {levelName(topic)}
                        </span>
                        <svg class="row__chevron" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
                          <path
                            d="M5 7.5l5 5 5-5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </summary>
                      <div class="row__body">
                        <p class="row__finding">{t(lang, k(topic, 'f'))}</p>
                        <p>
                          <strong>{t(lang, 'evd_means')}.</strong> {t(lang, k(topic, 'm'))}
                        </p>
                        <p class="row__source">
                          {t(lang, 'evd_source')}:{' '}
                          <a href={source.url} rel="noopener" target="_blank">
                            {source.name}
                          </a>
                        </p>
                        <a class="link-arrow row__page" href={evidenceTopicPath(lang, topic.id)}>
                          {evidenceContent[lang].ui.seePage}
                        </a>
                      </div>
                    </details>
                  </li>
                );
              })}
          </ul>
        </div>
      ))
    }

    <p class="grades__all">
      <a class="link-arrow" href={evidenceHubPath(lang)}>{evidenceContent[lang].ui.hubLink}</a>
    </p>

    <p class="grades__disclaimer">{t(lang, 'evd_disclaimer')}</p>
  </div>
</section>

<style>
  .row__page {
    margin-top: 0.25rem;
    font-size: var(--fs-small);
  }

  .grades__all {
    margin: clamp(2rem, 1.5rem + 1.5vw, 3rem) 0 0;
  }

  /* Cada grupo: título a la izquierda, filas de etiqueta a la derecha. */
  .grades__group {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--grid-gap);
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-ink);
  }

  .grades__group + .grades__group {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .grades__group-title {
    font-size: var(--fs-h3);
  }

  .grades__list {
    display: grid;
  }

  .grades__list > li + li {
    border-top: 1px solid var(--c-line);
  }

  .row__summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    gap: 1rem;
    align-items: center;
    min-height: 4.25rem;
    padding: 0.75rem 0.25rem;
    cursor: pointer;
    list-style: none;
  }

  .row__summary::-webkit-details-marker {
    display: none;
  }

  .row__title {
    font-size: 1.125rem;
    font-weight: var(--fw-head);
    line-height: 1.3;
    transition: color var(--dur-fast) linear;
  }

  .row__summary:hover .row__title {
    color: var(--c-green-ink);
  }

  .row__level {
    font-size: var(--fs-small);
    color: var(--c-ink-faint);
    text-align: end;
  }

  .row__chevron {
    color: var(--c-ink-soft);
    transition: rotate var(--dur-base) var(--ease-out);
  }

  .row[open] .row__chevron {
    rotate: 180deg;
  }

  /* La nota: un troquel pequeño con la letra. */
  .grade {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-1);
    font-size: 1.5rem;
    font-weight: var(--fw-grade);
    line-height: 1;
  }

  .grade--a {
    background-color: var(--grade-a);
    color: var(--grade-a-ink);
  }

  .grade--b {
    background-color: var(--grade-b);
    color: var(--grade-b-ink);
  }

  .grade--c {
    background-color: var(--grade-c);
    color: var(--grade-c-ink);
  }

  .grade--d {
    background-color: var(--grade-d);
    color: var(--grade-d-ink);
  }

  .grade--e {
    background-color: var(--grade-e);
    color: var(--grade-e-ink);
  }

  /* Apertura animada hasta su altura natural (mejora progresiva: sin soporte,
     abre al instante). */
  .row::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
  }

  .row:not([open])::details-content {
    block-size: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .row::details-content {
      transition:
        block-size 300ms var(--ease-out),
        content-visibility 300ms,
        display 300ms;
      transition-behavior: allow-discrete;
    }
  }

  .row__body {
    max-width: var(--measure);
    padding: 0 0.25rem 1.5rem calc(2.75rem + 1.25rem);
  }

  .row__finding {
    font-size: 1.0625rem;
    font-weight: var(--fw-head);
    line-height: 1.5;
  }

  .row__source {
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .row__source a {
    overflow-wrap: anywhere;
  }

  .row__source a:hover {
    text-decoration-color: var(--c-green);
  }

  .grades__disclaimer {
    max-width: var(--measure);
    margin-top: 2.5rem;
    font-size: var(--fs-small);
    color: var(--c-ink-faint);
  }

  @media (max-width: 50rem) {
    .grades__group {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .row__summary {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'grade title chevron'
        'grade level chevron';
      gap: 0.15rem 0.875rem;
    }

    .grade {
      grid-area: grade;
    }

    .row__title {
      grid-area: title;
      font-size: 1.0625rem;
    }

    .row__level {
      grid-area: level;
      text-align: start;
    }

    .row__chevron {
      grid-area: chevron;
    }

    .row__body {
      padding: 0 0 1.25rem;
    }
  }
</style>
