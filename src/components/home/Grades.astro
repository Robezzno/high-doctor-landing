---
import { evidenceSources, evidenceTopics, gradeOf, type EvidenceTopic } from '../../data/evidence';
import { t, type Lang, type TranslationKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const k = (topic: EvidenceTopic, part: 't' | 'f' | 'm') => `evd_${topic.id}_${part}` as TranslationKey;
const levelName = (topic: EvidenceTopic) => t(lang, `evd_lvl_${topic.level}` as TranslationKey);

const groups = [
  { id: 'use', title: t(lang, 'evd_group_use'), tag: t(lang, 'v2_tag_use') },
  { id: 'risk', title: t(lang, 'evd_group_risk'), tag: t(lang, 'v2_tag_risk') },
] as const;
---

<!-- Todas las notas: cada tema es una ficha que se despliega (details nativo,
     funciona sin JavaScript y con teclado). -->
<section class="section grades" id="evidence" aria-labelledby="grades-title">
  <div class="container">
    <div class="head" data-reveal>
      <h2 id="grades-title">{t(lang, 'v2_grid_title')}</h2>
      <p>{t(lang, 'v2_grid_lead')}</p>
    </div>

    {
      groups.map((group) => (
        <div class="grades__group">
          <h3 class="grades__group-title">{group.title}</h3>
          <ul class="grades__list" data-reveal>
            {evidenceTopics
              .filter((topic) => topic.group === group.id)
              .map((topic) => {
                const grade = gradeOf(topic.level);
                const source = evidenceSources[topic.source];
                return (
                  <li>
                    <details class="card" id={`evd-${topic.id}`} name="evidence">
                      <summary class="card__summary">
                        <span class={`grade grade--${grade.toLowerCase()}`} aria-hidden="true">
                          {grade}
                        </span>
                        <span class="card__main">
                          <span class={`tag tag--${group.id}`}>{group.tag}</span>
                          <span class="card__title">{t(lang, k(topic, 't'))}</span>
                          <span class="card__level">
                            <span class="visually-hidden">{t(lang, 'v2_grade_label')}: {grade}, </span>
                            {levelName(topic)}
                          </span>
                        </span>
                        <svg class="card__chevron" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                          <path
                            d="M5 7.5l5 5 5-5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </summary>
                      <div class="card__body">
                        <p class="card__finding">{t(lang, k(topic, 'f'))}</p>
                        <p>
                          <strong>{t(lang, 'evd_means')}.</strong> {t(lang, k(topic, 'm'))}
                        </p>
                        <p class="card__source">
                          {t(lang, 'evd_source')}:{' '}
                          <a href={source.url} rel="noopener" target="_blank">
                            {source.name}
                          </a>
                        </p>
                      </div>
                    </details>
                  </li>
                );
              })}
          </ul>
        </div>
      ))
    }

    <p class="grades__disclaimer">{t(lang, 'evd_disclaimer')}</p>
  </div>
</section>

<style>
  .grades__group + .grades__group {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .grades__group-title {
    margin-bottom: 1rem;
    font-size: var(--fs-h3);
  }

  .grades__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: start;
  }

  .card {
    border-radius: var(--r-2);
    background-color: var(--c-paper-2);
    transition:
      background-color var(--dur-fast) linear,
      box-shadow var(--dur-base) var(--ease-out);
  }

  .card:hover {
    background-color: var(--c-paper-3);
  }

  .card[open] {
    background-color: var(--c-white);
    box-shadow: var(--shadow-2);
  }

  .card__summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1.1rem 0.9rem 0.9rem;
    cursor: pointer;
    list-style: none;
    border-radius: var(--r-2);
  }

  .card__summary::-webkit-details-marker {
    display: none;
  }

  .card__main {
    display: grid;
    gap: 0.3rem;
    justify-items: start;
  }

  .card__title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .card__level {
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .card__chevron {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .card[open] .card__chevron {
    transform: rotate(180deg);
  }

  /* La nota: un cuadrado troquelado con la letra. */
  .grade {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 12px;
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    transition: transform var(--dur-base) var(--ease-spring);
  }

  .card:hover .grade,
  .card[open] .grade {
    transform: scale(1.06) rotate(-3deg);
  }

  .grade--a {
    background-color: var(--grade-a);
    color: var(--grade-a-ink);
  }

  .grade--b {
    background-color: var(--grade-b);
    color: var(--grade-b-ink);
  }

  .grade--c {
    background-color: var(--grade-c);
    color: var(--grade-c-ink);
  }

  .grade--d {
    background-color: var(--grade-d);
    color: var(--grade-d-ink);
  }

  .grade--e {
    background-color: var(--grade-e);
    color: var(--grade-e-ink);
  }

  .card__body {
    padding: 0 1.25rem 1.25rem calc(0.9rem + 4rem + 1rem);
  }

  .card__finding {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .card__source {
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .card__source a {
    overflow-wrap: anywhere;
  }

  .card__source a:hover {
    text-decoration-color: var(--c-green);
  }

  .grades__disclaimer {
    max-width: var(--measure);
    margin-top: 2rem;
    font-size: var(--fs-small);
    color: var(--c-ink-faint);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card[open] .card__body {
      animation: open-body 380ms var(--ease-out);
    }

    @keyframes open-body {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
    }
  }

  @media (max-width: 50rem) {
    .grades__list {
      grid-template-columns: 1fr;
    }

    .grade {
      width: 3.25rem;
      height: 3.25rem;
      font-size: 1.85rem;
    }

    .card__body {
      padding: 0 1rem 1.15rem;
    }
  }
</style>
