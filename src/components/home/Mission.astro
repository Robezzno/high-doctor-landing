---
import { Picture } from 'astro:assets';
import microscopes from '../../assets/photos/microscopes.jpg';
import { t, type Lang, type TranslationKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const items: TranslationKey[] = [
  'mission_li_1',
  'mission_li_2',
  'mission_li_3',
  'mission_li_4',
  'mission_li_5',
  'mission_li_6',
];
---

<!-- Página de texto del informe: el titular a la izquierda, la declaración
     colgando del centro de la página y una sola fotografía que cuelga por
     debajo del último renglón. -->
<section class="mission" id="mission" aria-labelledby="mission-title">
  <div class="container mission__grid" data-reveal>
    <h2 class="h2 mission__title" id="mission-title">{t(lang, 'mission_title')}</h2>
    <p class="mission__statement">{t(lang, 'mission_lead')}</p>
    <p class="mission__desc">{t(lang, 'mission_desc')}</p>
    <figure class="mission__photo">
      <Picture
        src={microscopes}
        formats={['avif', 'webp']}
        widths={[400, 640, 900]}
        sizes="(max-width: 55rem) 62vw, 22vw"
        alt={t(lang, 'mission_alt_microscopes')}
        class="photo"
        loading="lazy"
      />
    </figure>
    <p class="mission__note">{t(lang, 'mission_note')}</p>
    <h3 class="mission__list-title">{t(lang, 'mission_list_title')}</h3>
    <ul class="mission__list">
      {items.map((key) => <li>{t(lang, key)}</li>)}
    </ul>
  </div>
</section>

<style>
  .mission {
    padding-block: var(--section-y);
  }

  .mission__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    align-items: start;
  }

  .mission__title {
    grid-column: 1 / 6;
    grid-row: 1;
  }

  .mission__statement {
    grid-column: 7 / 13;
    grid-row: 1;
    margin: 0 0 1.25em;
    padding-top: clamp(0rem, 4vw, 5rem);
    font-size: var(--step-lead);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.02em;
    text-indent: 3em;
  }

  .mission__desc {
    grid-column: 7 / 12;
    grid-row: 2;
    margin: 0 0 3.5rem;
    max-width: 44ch;
  }

  .mission__photo {
    grid-column: 1 / 4;
    grid-row: 2 / span 3;
    margin: 0;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: var(--c-paper-2);
  }

  .mission__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    transition: transform 1.2s var(--ease-out);
  }

  .mission__photo:hover :global(img) {
    transform: scale(1.04);
  }

  .mission__note {
    grid-column: 1 / 3;
    grid-row: 5;
    margin: 2rem 0 0;
    font-size: var(--step-small);
    font-weight: 500;
    line-height: 1.45;
  }

  .mission__list-title {
    grid-column: 7 / 13;
    grid-row: 3;
    margin-bottom: 1.25rem;
    font-size: var(--step-lead);
  }

  /* Las seis líneas como bandas de tono alterno, no como viñetas. */
  .mission__list {
    grid-column: 7 / 13;
    grid-row: 4 / span 2;
    display: grid;
    gap: 4px;
  }

  .mission__list li {
    padding: 0.95rem 1.15rem;
    background-color: var(--c-paper-2);
    font-weight: 500;
    line-height: 1.35;
    transition:
      background-color var(--dur-fast) linear,
      transform var(--dur-base) var(--ease-out);
  }

  .mission__list li:nth-child(even) {
    background-color: var(--c-paper-3);
  }

  .mission__list li:hover {
    background-color: var(--c-green);
    transform: translateY(-2px);
  }

  @media (max-width: 55rem) {
    .mission__grid {
      grid-template-columns: 34fr 66fr;
      grid-auto-flow: row dense;
      column-gap: 1rem;
    }

    .mission__grid > * {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .mission__statement {
      margin-top: 2rem;
      padding-top: 0;
      font-size: 1.375rem;
      text-indent: 0;
    }

    .mission__desc {
      margin-bottom: 2rem;
    }

    .mission__grid > .mission__note {
      grid-column: 1;
      align-self: end;
      margin: 0 0 3rem;
    }

    .mission__grid > .mission__photo {
      grid-column: 2;
      aspect-ratio: 4 / 5;
      margin-bottom: 3rem;
    }

  }
</style>
