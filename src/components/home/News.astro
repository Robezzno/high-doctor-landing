---
import NewsFigure from '../news/NewsFigure.astro';
import { t, type Lang } from '../../i18n';
import {
  blogHrefForSiteLang,
  categoryLabel,
  formatShortDate,
  getPosts,
  isoDate,
  postUrl,
  slugOf,
} from '../../lib/news';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** EN y ES muestran su idioma; los otros seis, las noticias en EN. */
const newsLang = lang === 'es' ? 'es' : 'en';
const posts = (await getPosts(newsLang)).slice(0, 3);
const blogHref = blogHrefForSiteLang(lang);
const showLanguageNote = lang !== 'es' && lang !== 'en';
---

{
  posts.length > 0 && (
    <section class="section news" id="news" aria-labelledby="news-title">
      <div class="container">
        <div class="news__head" data-reveal>
          <div class="head">
            <h2 id="news-title">{t(lang, 'home_news_title')}</h2>
            {showLanguageNote && <p>{t(lang, 'home_news_note')}</p>}
          </div>
          <a class="link-arrow" href={blogHref}>
            {t(lang, 'v2_news_cta')}
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M2 8h11M9 3.5 13.5 8 9 12.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>

        <ul class="news__list" data-reveal>
          {posts.map((post) => {
            const slug = slugOf(post);
            return (
              <li class="post">
                {post.data.grafico ? (
                  <NewsFigure
                    figure={post.data.grafico}
                    lang={newsLang}
                    category={post.data.category}
                    categoryText={categoryLabel(newsLang, post.data.category)}
                    variant="teaser"
                  />
                ) : (
                  <img
                    class="post__image"
                    src={`/social/${newsLang}/${slug}.jpg`}
                    width="1080"
                    height="1350"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="post__body">
                  <p class="post__meta">
                    <time datetime={isoDate(post.data.date)}>{formatShortDate(post.data.date)}</time>
                  </p>
                  <h3 class="post__title">
                    <a href={postUrl(newsLang, slug)} transition:name={`post-title-${slug}`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="post__summary">{post.data.summary}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .news__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0 2rem;
  }

  .news__head > .link-arrow {
    margin-bottom: clamp(2rem, 1.4rem + 2vw, 3rem);
  }

  .news__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  /* Tarjeta plana: el gráfico arriba y el texto debajo, sin caja ni sombra. */
  .post {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1rem;
  }

  .post {
    min-width: 0;
  }

  .post :global(.nf) {
    min-block-size: clamp(10rem, 6rem + 10vw, 14rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .post :global(.nf) {
      transition: translate var(--dur-base) var(--ease-out);
    }

    .post:hover :global(.nf) {
      translate: 0 -3px;
    }
  }

  .post__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .post__body {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .post__title {
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .post__title a {
    text-decoration: none;
  }

  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post:hover .post__title a {
    text-decoration: underline;
    text-decoration-color: var(--c-green);
  }

  .post__summary {
    margin: 0;
    font-size: 1rem;
    color: var(--c-ink-soft);
  }

  @media (max-width: 55rem) {
    .news__list {
      grid-template-columns: 1fr;
    }

    .post__summary {
      display: none;
    }
  }
</style>
