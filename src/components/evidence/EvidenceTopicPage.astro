---
/**
 * Ficha de un tema de evidencia (`/evidence/<slug>/`, `/es/evidencia/<slug>/`…).
 *
 * Lo que ya existía en la portada (nota, nivel, fuente, «qué dice», «qué
 * significa») sale de `src/data/evidence.ts` y de i18n; el texto propio de la
 * ficha, de `src/data/evidence-pages/<lang>.json` (ver `src/lib/evidence`).
 */
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import EvidenceScale from './EvidenceScale.astro';
import { evidenceSources, gradeOf, type EvidenceTopicId } from '../../data/evidence';
import {
  EVIDENCE_REVIEWED,
  evidenceAlternates,
  evidenceContent,
  evidenceHubPath,
  evidenceTopicPath,
  otherTopics,
  topicById,
} from '../../lib/evidence';
import { formatShortDate, getPosts, postUrl, slugOf } from '../../lib/news';
import { langPath, t, type Lang, type TranslationKey } from '../../i18n';

interface Props {
  lang: Lang;
  id: EvidenceTopicId;
}

const { lang, id } = Astro.props;

const topic = topicById(id);
const content = evidenceContent[lang];
const page = content.topics[id];
const ui = content.ui;
const grade = gradeOf(topic.level);
const source = evidenceSources[topic.source];
const tk = (key: string) => t(lang, key as TranslationKey);
const title = tk(`evd_${id}_t`);
const finding = tk(`evd_${id}_f`);
const meaning = tk(`evd_${id}_m`);
const levelName = tk(`evd_lvl_${topic.level}`);

const site = Astro.site ?? new URL('https://highdoctor.foundation');
const abs = (path: string) => new URL(path, site).href;
const path = evidenceTopicPath(lang, id);

const alternates: { lang: string; href: string }[] = evidenceAlternates(id).map((item) => ({
  lang: item.lang,
  href: abs(item.path),
}));
alternates.push({ lang: 'x-default', href: abs(evidenceTopicPath('en', id)) });
const langHrefs = Object.fromEntries(evidenceAlternates(id).map((item) => [item.lang, item.path]));

// Noticias del blog que tratan este tema (campo `evidencia` de la noticia).
// El blog sólo existe en ES y EN; el resto de idiomas enlaza las de EN.
const newsLang = lang === 'es' ? 'es' : 'en';
const related = (await getPosts(newsLang)).filter((post) => post.data.evidencia?.includes(id)).slice(0, 3);

const others = otherTopics(id);

const reviewedLabel = new Intl.DateTimeFormat(lang, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${EVIDENCE_REVIEWED}T12:00:00Z`));

// Datos estructurados: página médica, la pregunta con su respuesta y las migas.
const medicalPage: Record<string, unknown> = {
  name: page.question,
  description: page.description,
  url: abs(path),
  inLanguage: lang,
  lastReviewed: EVIDENCE_REVIEWED,
  about: { '@type': 'Thing', name: title },
  isBasedOn: source.url,
  publisher: { '@type': 'Organization', name: 'High Doctor Foundation', url: site.href },
};
medicalPage['@context'] = 'https://schema.org';
medicalPage['@type'] = 'MedicalWebPage';

const faq: Record<string, unknown> = {
  mainEntity: [
    {
      '@type': 'Question',
      name: page.question,
      acceptedAnswer: { '@type': 'Answer', text: `${finding} ${meaning}` },
    },
  ],
};
faq['@context'] = 'https://schema.org';
faq['@type'] = 'FAQPage';

const crumbs = [
  { name: ui.crumbHome, href: langPath(lang) },
  { name: ui.crumbHub, href: evidenceHubPath(lang) },
  { name: title, href: path },
];
const breadcrumb: Record<string, unknown> = {
  itemListElement: crumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: abs(crumb.href),
  })),
};
breadcrumb['@context'] = 'https://schema.org';
breadcrumb['@type'] = 'BreadcrumbList';

const sections = [
  { heading: ui.studied, text: page.studied },
  { heading: ui.unknown, text: page.unknown },
  { heading: ui.practical, text: page.practical },
];
---

<Base
  lang={lang}
  title={page.question}
  description={page.description}
  alternates={alternates}
  structuredData={[medicalPage, faq, breadcrumb]}
>
  <Nav lang={lang} sectionBase={langPath(lang)} current="evidence" langHrefs={langHrefs} />

  <main id="main" class="evp">
    <div class="container evp__inner">
      <nav class="evp__crumbs" aria-label={ui.crumbHub}>
        <ol>
          {
            crumbs.map((crumb, index) => (
              <li>
                {index < crumbs.length - 1 ? (
                  <a href={crumb.href}>{crumb.name}</a>
                ) : (
                  <span aria-current="page">{crumb.name}</span>
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      <header class="evp__head">
        <p class:list={['evp__kind', `evp__kind--${topic.group}`]}>
          {topic.group === 'use' ? ui.kindUse : ui.kindRisk} · {title}
        </p>
        <h1 class="evp__title">{page.question}</h1>
        <p class="evp__lead">{finding}</p>
      </header>

      <section class="evp__verdict" aria-labelledby="evp-verdict">
        <p class="evp__grade" aria-hidden="true">{grade}</p>
        <div class="evp__verdict-text">
          <h2 class="evp__verdict-label" id="evp-verdict">
            {ui.verdictLabel}
            <span class="visually-hidden">: {grade},</span>
          </h2>
          <p class="evp__level">{levelName}</p>
          <p class="evp__means"><strong>{t(lang, 'evd_means')}.</strong> {meaning}</p>
          <p class="evp__source">
            {t(lang, 'evd_source')}:{' '}
            <a href={source.url} rel="noopener" target="_blank">{source.name}</a>
          </p>
        </div>
      </section>

      <div class="evp__body">
        {
          sections.map((section) => (
            <section class="evp__section">
              <h2>{section.heading}</h2>
              <p>{section.text}</p>
            </section>
          ))
        }

        <section class="evp__section">
          <h2>{ui.scaleTitle}</h2>
          <p>{ui.scaleLead}</p>
          <EvidenceScale lang={lang} level={topic.level} />
        </section>

        <p class="evp__disclaimer" role="note">{t(lang, 'evd_disclaimer')}</p>
        <p class="evp__reviewed">{ui.reviewed}: <time datetime={EVIDENCE_REVIEWED}>{reviewedLabel}</time></p>
      </div>

      {
        related.length > 0 && (
          <section class="evp__related" aria-labelledby="evp-news">
            <h2 id="evp-news">{ui.relatedNews}</h2>
            <ul>
              {related.map((post) => (
                <li>
                  <a href={postUrl(newsLang, slugOf(post))} hreflang={newsLang}>
                    {post.data.title}
                  </a>
                  <time datetime={post.data.date.toISOString()}>{formatShortDate(post.data.date)}</time>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="evp__others" aria-labelledby="evp-others">
        <div class="evp__others-head">
          <h2 id="evp-others">{ui.otherTopics}</h2>
          <a class="link-arrow" href={evidenceHubPath(lang)}>{ui.hubLink}</a>
        </div>
        <ul class="evp__grid">
          {
            others.map((other) => (
              <li>
                <a class="evp__card" href={evidenceTopicPath(lang, other.id)}>
                  <span class={`evp__chip grade-chip grade-chip--${gradeOf(other.level).toLowerCase()}`} aria-hidden="true">
                    {gradeOf(other.level)}
                  </span>
                  <span>{evidenceContent[lang].topics[other.id].question}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <aside class="evp__cta">
        <div>
          <h2>{ui.ctaTitle}</h2>
          <p>{ui.ctaText}</p>
        </div>
        <a class="btn btn--accent" href={`${langPath(lang)}#join`}>{t(lang, 'v2_menu_join')}</a>
      </aside>
    </div>
  </main>

  <Footer lang={lang} sectionBase={langPath(lang)} />
</Base>

<style>
  .evp {
    padding-block: clamp(2rem, 1rem + 4vw, 4rem) var(--section-y);
  }

  .evp__inner {
    display: grid;
    gap: clamp(2rem, 1.25rem + 2.5vw, 3.5rem);
  }

  .evp__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .evp__crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--c-ink-faint);
  }

  .evp__crumbs a {
    color: inherit;
  }

  .evp__head {
    display: grid;
    gap: 1rem;
    max-width: 52rem;
  }

  .evp__kind {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--fs-small);
    font-weight: var(--fw-head);
    color: var(--c-ink-soft);
  }

  .evp__kind::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--c-green);
  }

  .evp__kind--risk::before {
    background-color: var(--c-ink);
  }

  .evp__title {
    margin: 0;
    font-size: var(--fs-h1);
    font-weight: var(--fw-head);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .evp__lead {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--fs-lead, 1.25rem);
    line-height: 1.45;
    color: var(--c-ink-soft);
  }

  /* El veredicto: la letra grande, como en la etiqueta de la portada. */
  .evp__verdict {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.25rem, 0.5rem + 3vw, 3rem);
    align-items: center;
    max-width: 52rem;
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.25rem);
    border-top: 6px solid var(--c-ink);
    border-bottom: 1px solid var(--c-ink);
  }

  .evp__grade {
    margin: 0;
    font-size: var(--fs-grade);
    font-weight: var(--fw-grade);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .evp__verdict-text {
    display: grid;
    gap: 0.5rem;
  }

  .evp__verdict-text p,
  .evp__verdict-label {
    margin: 0;
  }

  .evp__verdict-label {
    font-size: var(--fs-small);
    font-weight: var(--fw-regular);
    color: var(--c-ink-soft);
  }

  .evp__level {
    font-size: var(--fs-h2);
    font-weight: var(--fw-head);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .evp__source {
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .evp__body {
    display: grid;
    gap: 2rem;
    max-width: var(--measure);
  }

  .evp__section h2,
  .evp__related h2,
  .evp__others h2,
  .evp__cta h2 {
    margin: 0 0 0.75rem;
    font-size: var(--fs-h3);
  }

  .evp__section p {
    margin: 0;
    line-height: 1.65;
  }

  .evp__disclaimer {
    margin: 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--c-green);
    background-color: var(--c-paper-2);
    font-size: var(--fs-small);
  }

  .evp__reviewed {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--c-ink-faint);
  }

  .evp__related ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 52rem;
  }

  .evp__related li {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--c-line);
  }

  .evp__related a {
    font-weight: var(--fw-head);
  }

  .evp__related time {
    font-size: var(--fs-small);
    color: var(--c-ink-faint);
  }

  .evp__others-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-ink);
  }

  .evp__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evp__card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.875rem;
    align-items: center;
    padding: 0.875rem 0.25rem;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-ink);
    font-weight: var(--fw-head);
    line-height: 1.3;
    text-decoration: none;
  }

  .evp__card:hover span:last-child {
    color: var(--c-green-ink);
  }

  .grade-chip {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-1);
    font-size: 1.125rem;
    font-weight: var(--fw-grade);
  }

  .grade-chip--a { background-color: var(--grade-a); color: var(--grade-a-ink); }
  .grade-chip--b { background-color: var(--grade-b); color: var(--grade-b-ink); }
  .grade-chip--c { background-color: var(--grade-c); color: var(--grade-c-ink); }
  .grade-chip--d { background-color: var(--grade-d); color: var(--grade-d-ink); }
  .grade-chip--e { background-color: var(--grade-e); color: var(--grade-e-ink); }

  .evp__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.25rem);
    border-radius: var(--r-2);
    background-color: var(--c-ink);
    color: var(--c-white);
  }

  .evp__cta p {
    margin: 0;
    color: var(--c-paper-muted);
  }

  @media (max-width: 40rem) {
    .evp__verdict {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding-inline: 0;
    }

    .evp__grade {
      font-size: clamp(5rem, 30vw, 7rem);
    }
  }
</style>
