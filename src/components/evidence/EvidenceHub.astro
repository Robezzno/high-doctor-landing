---
/** Índice de fichas de evidencia de un idioma (`/evidence/`, `/es/evidencia/`…). */
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { evidenceTopics, gradeOf, type EvidenceTopic } from '../../data/evidence';
import { evidenceAlternates, evidenceContent, evidenceHubPath, evidenceTopicPath } from '../../lib/evidence';
import { langPath, t, type Lang, type TranslationKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = evidenceContent[lang];
const ui = content.ui;

const site = Astro.site ?? new URL('https://highdoctor.foundation');
const abs = (path: string) => new URL(path, site).href;
const alternates: { lang: string; href: string }[] = evidenceAlternates().map((item) => ({
  lang: item.lang,
  href: abs(item.path),
}));
alternates.push({ lang: 'x-default', href: abs(evidenceHubPath('en')) });
const langHrefs = Object.fromEntries(evidenceAlternates().map((item) => [item.lang, item.path]));

const byGrade = (a: EvidenceTopic, b: EvidenceTopic) => gradeOf(a.level).localeCompare(gradeOf(b.level));
const groups = [
  { id: 'use', title: t(lang, 'evd_group_use') },
  { id: 'risk', title: t(lang, 'evd_group_risk') },
] as const;

const breadcrumb: Record<string, unknown> = {
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.crumbHome, item: abs(langPath(lang)) },
    { '@type': 'ListItem', position: 2, name: ui.crumbHub, item: abs(evidenceHubPath(lang)) },
  ],
};
breadcrumb['@context'] = 'https://schema.org';
breadcrumb['@type'] = 'BreadcrumbList';
---

<Base lang={lang} title={ui.hubTitle} description={ui.hubDescription} alternates={alternates} structuredData={[breadcrumb]}>
  <Nav lang={lang} sectionBase={langPath(lang)} current="evidence" langHrefs={langHrefs} />

  <main id="main" class="evh">
    <div class="container evh__inner">
      <header class="evh__head">
        <h1 class="evh__title">{ui.hubTitle}</h1>
        <p class="evh__lead">{ui.hubLead}</p>
      </header>

      {
        groups.map((group) => (
          <section class="evh__group" aria-labelledby={`evh-${group.id}`}>
            <h2 id={`evh-${group.id}`}>{group.title}</h2>
            <ul>
              {evidenceTopics
                .filter((topic) => topic.group === group.id)
                .sort(byGrade)
                .map((topic) => {
                  const grade = gradeOf(topic.level);
                  return (
                    <li>
                      <a class="evh__row" href={evidenceTopicPath(lang, topic.id)}>
                        <span class={`evh__grade evh__grade--${grade.toLowerCase()}`} aria-hidden="true">
                          {grade}
                        </span>
                        <span class="evh__text">
                          <span class="evh__q">{content.topics[topic.id].question}</span>
                          <span class="evh__f">{t(lang, `evd_${topic.id}_f` as TranslationKey)}</span>
                        </span>
                        <span class="evh__level">
                          <span class="visually-hidden">{t(lang, 'v2_grade_label')}: {grade}, </span>
                          {t(lang, `evd_lvl_${topic.level}` as TranslationKey)}
                        </span>
                      </a>
                    </li>
                  );
                })}
            </ul>
          </section>
        ))
      }

      <p class="evh__disclaimer" role="note">{t(lang, 'evd_disclaimer')}</p>
    </div>
  </main>

  <Footer lang={lang} sectionBase={langPath(lang)} />
</Base>

<style>
  .evh {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) var(--section-y);
  }

  .evh__inner {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .evh__head {
    display: grid;
    gap: 1rem;
    max-width: 52rem;
  }

  .evh__title {
    margin: 0;
    font-size: var(--fs-h1);
    font-weight: var(--fw-head);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .evh__lead {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--fs-lead);
    color: var(--c-ink-soft);
  }

  .evh__group {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--grid-gap);
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-ink);
  }

  .evh__group h2 {
    margin: 0;
    font-size: var(--fs-h3);
  }

  .evh__group ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evh__group li + li {
    border-top: 1px solid var(--c-line);
  }

  .evh__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0.25rem;
    color: var(--c-ink);
    text-decoration: none;
  }

  .evh__text {
    display: grid;
    gap: 0.25rem;
  }

  .evh__q {
    font-size: 1.125rem;
    font-weight: var(--fw-head);
    line-height: 1.3;
  }

  .evh__row:hover .evh__q {
    color: var(--c-green-ink);
  }

  .evh__f {
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
    line-height: 1.45;
  }

  .evh__level {
    font-size: var(--fs-small);
    color: var(--c-ink-faint);
    text-align: end;
  }

  .evh__grade {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-1);
    font-size: 1.5rem;
    font-weight: var(--fw-grade);
  }

  .evh__grade--a { background-color: var(--grade-a); color: var(--grade-a-ink); }
  .evh__grade--b { background-color: var(--grade-b); color: var(--grade-b-ink); }
  .evh__grade--c { background-color: var(--grade-c); color: var(--grade-c-ink); }
  .evh__grade--d { background-color: var(--grade-d); color: var(--grade-d-ink); }
  .evh__grade--e { background-color: var(--grade-e); color: var(--grade-e-ink); }

  .evh__disclaimer {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  @media (max-width: 55rem) {
    .evh__group {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .evh__row {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .evh__level {
      display: none;
    }
  }
</style>
