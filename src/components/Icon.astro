---
/**
 * Iconos lineales propios (24 × 24, trazo 1.4, mismo grosor en todos).
 * Nada de emojis: el set se dibuja a mano para que sea coherente.
 */
export type IconName =
  | 'flask'
  | 'book'
  | 'pulse'
  | 'shield'
  | 'people'
  | 'globe'
  | 'arrow'
  | 'mail'
  | 'star';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'flask' && (
      <>
        <path d="M9.4 3h5.2" />
        <path d="M10.4 3v5.3L5.1 18.1c-.6 1.1.2 2.4 1.5 2.4h10.8c1.3 0 2.1-1.3 1.5-2.4L13.6 8.3V3" />
        <path d="M7.6 15.4h8.8" />
      </>
    )
  }
  {
    name === 'book' && (
      <>
        <path d="M12 6.6C9.8 5.1 7 4.7 3.6 5.6v12.8c3.4-.9 6.2-.5 8.4 1 2.2-1.5 5-1.9 8.4-1V5.6c-3.4-.9-6.2-.5-8.4 1z" />
        <path d="M12 6.6v12.8" />
      </>
    )
  }
  {
    name === 'pulse' && (
      <>
        <path d="M12 20.4C8.3 17.8 4.2 14.4 4.2 10.5A4.2 4.2 0 0 1 12 8.1a4.2 4.2 0 0 1 7.8 2.4c0 3.9-4.1 7.3-7.8 9.9z" />
        <path d="M5.8 12.1h2.9l1.6-2.7 2.1 4.5 1.6-1.8h3.5" />
      </>
    )
  }
  {
    name === 'shield' && (
      <>
        <path d="M12 3.1 19.1 5.7v5.6c0 4.1-2.9 7.5-7.1 9.3-4.2-1.8-7.1-5.2-7.1-9.3V5.7z" />
        <path d="M12 9.6v4.9" />
        <path d="M9.6 12.05h4.8" />
      </>
    )
  }
  {
    name === 'people' && (
      <>
        <path d="M9.2 10.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
        <path d="M2.9 20a6.3 6.3 0 0 1 12.6 0" />
        <path d="M16.3 5.2a3 3 0 0 1 0 5.5" />
        <path d="M17.6 13.6A5.7 5.7 0 0 1 21.1 20" />
      </>
    )
  }
  {
    name === 'globe' && (
      <>
        <path d="M12 3.4a8.6 8.6 0 1 0 0 17.2 8.6 8.6 0 0 0 0-17.2z" />
        <path d="M3.5 9h17M3.5 15h17" />
        <path d="M12 3.4c2.4 2.4 3.6 5.3 3.6 8.6s-1.2 6.2-3.6 8.6c-2.4-2.4-3.6-5.3-3.6-8.6s1.2-6.2 3.6-8.6z" />
      </>
    )
  }
  {
    name === 'arrow' && (
      <>
        <path d="M4.4 12h14.4" />
        <path d="M13.2 6.4 19 12l-5.8 5.6" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <path d="M3.2 6.6h17.6v10.8H3.2z" />
        <path d="m3.6 7.2 8.4 6 8.4-6" />
      </>
    )
  }
  {
    name === 'star' && (
      <path d="M12 3.4l2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.8l6.1-.9z" />
    )
  }
</svg>
