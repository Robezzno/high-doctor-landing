---
/**
 * Gráfico de una noticia en HTML: el dato clave en grande, su etiqueta y hasta
 * tres datos (con barra si son porcentaje). Es el mismo contenido que dibuja
 * `scripts/social-card.ts` en la tarjeta social, pero como texto real: se lee,
 * se selecciona, se traduce y escala con su contenedor (container queries).
 *
 * `variant`:
 * - `card`  → destacado del blog: con los datos.
 * - `teaser` → tarjeta de la portada: cifra y etiqueta (los datos están en el post).
 * - `thumb` → miniatura del listado: sólo cifra y etiqueta.
 * - `cover` → portada del post: horizontal cuando hay sitio.
 */
import type { NewsFigure as Figure } from '../../lib/news/schema';

interface Props {
  figure: Figure;
  lang: 'es' | 'en';
  category: string;
  categoryText: string;
  variant?: 'card' | 'teaser' | 'thumb' | 'cover';
  /** Nombre de la View Transition compartida entre listado y post. */
  transitionName?: string;
}

const { figure, lang, category, categoryText, variant = 'card', transitionName } = Astro.props;

const percent = (value: number) => (lang === 'es' ? `${Math.round(value)} %` : `${Math.round(value)}%`);
const rows = variant === 'thumb' || variant === 'teaser' ? [] : figure.datos.slice(0, 3);
---

<div
  class:list={['nf', `nf--${variant}`, `nf--${category}`]}
  transition:name={transitionName}
  data-figure
>
  <div class="nf__in">
  {variant !== 'thumb' && <p class="nf__cat">{categoryText}</p>}
  <p class="nf__value">{figure.cifra}</p>
  <p class="nf__label">{figure.etiqueta}</p>
  {
    rows.length > 0 && (
      <ul class="nf__rows">
        {rows.map((row) =>
          typeof row.porcentaje === 'number' ? (
            <li class="nf__row nf__row--bar" style={`--nf-pct: ${Math.max(1.5, Math.min(100, row.porcentaje))}%`}>
              <span class="nf__pct">{percent(row.porcentaje)}</span> {row.texto}
            </li>
          ) : (
            <li class="nf__row">{row.texto}</li>
          ),
        )}
      </ul>
    )
  }
  </div>
</div>

<style>
  /* El bloque es el contenedor; el interior se adapta a su anchura. */
  .nf {
    container-type: inline-size;
    display: grid;
    min-width: 0;
    border-radius: var(--r-2);
    background-color: var(--c-ink);
    color: var(--c-white);
  }

  .nf__in {
    display: grid;
    align-content: center;
    gap: 0.5rem;
    padding: clamp(1rem, 6cqi, 2.25rem);
  }

  .nf p {
    margin: 0;
  }

  .nf__cat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: var(--fw-head);
    color: var(--c-paper-muted);
  }

  .nf__cat::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--c-green);
  }

  /* La cifra: verde de la estrella del logo, grande y apretada. */
  .nf__value {
    font-size: clamp(2rem, 17cqi, 5.5rem);
    font-weight: var(--fw-grade);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--c-green);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .nf__label {
    max-width: 30ch;
    font-size: clamp(0.9375rem, 4.4cqi, 1.25rem);
    font-weight: var(--fw-head);
    line-height: 1.3;
    text-wrap: balance;
  }

  .nf__rows {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgb(255 255 255 / 18%);
  }

  .nf__row {
    position: relative;
    padding-left: 1rem;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--c-paper-muted);
  }

  .nf__row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background-color: var(--c-green);
  }

  /* Fila con porcentaje: cifra + texto y, debajo, la barra proporcional. */
  .nf__row--bar {
    padding-left: 0;
    padding-bottom: 0.75rem;
  }

  .nf__row--bar::before {
    top: auto;
    bottom: 0;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      var(--c-green) var(--nf-pct),
      rgb(255 255 255 / 18%) var(--nf-pct)
    );
  }

  .nf__pct {
    font-weight: var(--fw-strong);
    color: var(--c-white);
    font-variant-numeric: tabular-nums;
  }

  /* Miniatura del listado: cuadrada y sólo con lo esencial. */
  .nf--thumb {
    aspect-ratio: 1;
    border-radius: var(--r-1);
  }

  .nf--thumb .nf__in {
    gap: 0.25rem;
    padding: 0.875rem;
  }

  .nf--thumb .nf__value {
    font-size: clamp(1.25rem, 20cqi, 2.5rem);
  }

  .nf--thumb .nf__label {
    font-size: 0.75rem;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Portada del post: horizontal cuando hay sitio (cifra y etiqueta a la
     izquierda, datos a la derecha). */
  @container (min-width: 38rem) {
    .nf--cover .nf__in {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 2.5rem;
      align-items: end;
    }

    .nf--cover .nf__cat,
    .nf--cover .nf__value,
    .nf--cover .nf__label {
      grid-column: 1;
    }

    .nf--cover .nf__rows {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: end;
      margin: 0;
      padding: 0 0 0 2.5rem;
      border-top: 0;
      border-left: 1px solid rgb(255 255 255 / 18%);
    }

    .nf--cover .nf__value {
      font-size: clamp(3rem, 11cqi, 5.5rem);
    }

    .nf--cover .nf__label {
      font-size: 1.125rem;
    }
  }
</style>
