---
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Mission from './Mission.astro';
import Impact from './Impact.astro';
import Join from './Join.astro';
import Event from './Event.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Nav lang={lang} />
<main id="main">
  <Hero lang={lang} />
  <Mission lang={lang} />
  <Impact lang={lang} />
  <Join lang={lang} />
  <Event lang={lang} />
</main>
<Footer lang={lang} />
