---
import Nav from './Nav.astro';
import Hero from './home/Hero.astro';
import Grades from './home/Grades.astro';
import Method from './home/Method.astro';
import News from './home/News.astro';
import About from './home/About.astro';
import Join from './home/Join.astro';
import Stats from './Stats.astro';
import Events from './Events.astro';
import Team from './Team.astro';
import Partners from './Partners.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Nav lang={lang} />

<main id="main">
  <!-- El orden sigue la prioridad del visitante: consultar primero. -->
  <Hero lang={lang} />
  <Grades lang={lang} />
  <Method lang={lang} />
  <News lang={lang} />
  <About lang={lang} />
  <!-- Secciones de confianza: se ocultan solas si falta el dato real
       (flags en src/config/site.ts). -->
  <Stats lang={lang} />
  <Team lang={lang} />
  <Partners lang={lang} />
  <Events lang={lang} />
  <Join lang={lang} />
</main>
<Footer lang={lang} />
