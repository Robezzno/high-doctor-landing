---
import { t, type Lang, type TranslationKey } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const missionItems: TranslationKey[] = [
  'mission_li_1',
  'mission_li_2',
  'mission_li_3',
  'mission_li_4',
  'mission_li_5',
  'mission_li_6',
];

const values: { label: TranslationKey; text: TranslationKey }[] = [
  { label: 'val_comm', text: 'val_comm_desc' },
  { label: 'val_cult', text: 'val_cult_desc' },
  { label: 'val_edu', text: 'val_edu_desc' },
  { label: 'val_resp', text: 'val_resp_desc' },
  { label: 'val_inno', text: 'val_inno_desc' },
];

/** Los textos de los valores vienen con dos puntos finales («Community:»). */
const stripColon = (value: string) => value.replace(/\s*:\s*$/, '');
---

<section id="mission" class="mission section section--paper grain reveal">
  <div class="container">
    <header class="section__head">
      <span class="tag">SPEC-02 / {t(lang, 'nav_mission')}</span>
      <span class="mono mission__folio">§ 02</span>
    </header>

    <div class="mission__grid grid">
      <div class="mission__lead">
        <h2 class="h2 mission__title">{t(lang, 'mission_title')}</h2>
        <p class="lead">{t(lang, 'mission_lead')}</p>

        <aside class="note mission__note">
          <span class="tape mission__tape" aria-hidden="true"></span>
          <h3 class="mono note__tag">{t(lang, 'vision_title')}</h3>
          <p>{t(lang, 'vision_desc')}</p>
        </aside>

        <div class="glossary">
          <h3 class="mono glossary__title">{t(lang, 'values_title')}</h3>
          <dl class="glossary__list">
            {
              values.map((value) => (
                <div class="glossary__row">
                  <dt>{stripColon(t(lang, value.label))}</dt>
                  <dd>{t(lang, value.text)}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="mission__body">
        <p class="mission__intro">{t(lang, 'mission_desc')}</p>

        <div class="protocol">
          <div class="protocol__head">
            <h3 class="mono protocol__title">{t(lang, 'mission_protocol')}</h3>
            <span class="mono protocol__range" aria-hidden="true">01 — 06</span>
          </div>
          <ol class="protocol__list">
            {
              missionItems.map((key, index) => (
                <li class="protocol__item">
                  <span class="mono protocol__num">{String(index + 1).padStart(2, '0')}</span>
                  <span class="protocol__text">{t(lang, key)}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mission__folio {
    color: var(--c-ink-faint);
  }

  .mission__lead {
    grid-column: 1 / span 5;
    min-width: 0;
  }

  .mission__body {
    grid-column: 7 / span 6;
    min-width: 0;
  }

  .mission__title {
    margin-bottom: var(--sp-s);
  }

  .mission__note {
    position: relative;
    margin-top: var(--sp-l);
  }

  .mission__tape {
    top: -0.85rem;
    right: 1.1rem;
    width: 5.5rem;
    rotate: 3deg;
  }

  /* Capitular: la primera letra del texto, en la serif de titulares. */
  .mission__intro {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--c-ink);
  }

  .mission__intro::first-letter {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-family: var(--font-display);
    font-size: 3.6em;
    font-weight: 600;
    line-height: 0.78;
    color: var(--c-ink);
  }

  /* ------------------------------------------------------------ Glosario */
  .glossary {
    margin-top: var(--sp-l);
    padding-top: var(--sp-s);
    border-top: 1px solid var(--c-paper-3);
  }

  .glossary__title {
    color: var(--c-ink-faint);
    margin-bottom: var(--sp-2xs);
  }

  .glossary__row {
    display: grid;
    gap: 0.1rem;
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--c-paper-3);
    font-size: var(--fs-small);
  }

  .glossary__row:last-child {
    border-bottom: 0;
  }

  .glossary__row dt {
    font-weight: 600;
    color: var(--c-ink);
  }

  .glossary__row dd {
    margin: 0;
    color: var(--c-ink-soft);
  }

  /* ------------------------------------------------------------ Protocolo */
  .protocol {
    margin-top: clamp(2rem, 4vw, 3.25rem);
  }

  .protocol__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-s);
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--c-ink);
  }

  .protocol__title {
    color: var(--c-ink);
  }

  .protocol__range {
    color: var(--c-ink-faint);
  }

  .protocol__list {
    counter-reset: protocol;
  }

  .protocol__item {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--sp-2xs);
    align-items: baseline;
    padding-block: clamp(0.7rem, 1.4vw, 1rem);
    border-bottom: 1px solid var(--c-paper-3);
  }

  .protocol__num {
    color: var(--c-green-deep);
    font-size: var(--fs-mono-lg);
  }

  .protocol__text {
    font-size: var(--fs-body);
    color: var(--c-ink);
  }

  .protocol__item:hover .protocol__num {
    background-color: var(--c-marker);
    color: var(--c-ink);
    padding-inline: 0.2rem;
  }

  @media (max-width: 68rem) {
    .mission__lead {
      grid-column: 1 / span 6;
    }

    .mission__body {
      grid-column: 7 / span 6;
    }
  }

  @media (max-width: 55rem) {
    .mission__lead,
    .mission__body {
      grid-column: 1 / -1;
    }

    .mission__body {
      margin-top: var(--sp-m);
    }
  }
</style>
