---
import { Picture } from 'astro:assets';
import character from '../assets/brand/logo-character.png';
import Molecule from './Molecule.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const title = t(lang, 'hero_title');

/**
 * Parte el titular por la palabra que va subrayada a rotulador. La palabra
 * viene del diccionario (`hero_title_hl`); si por lo que sea no apareciera en
 * el titular, se subraya la palabra más larga para no romper la composición.
 */
function splitHighlight(text: string, word: string) {
  const at = word ? text.toLocaleLowerCase().indexOf(word.toLocaleLowerCase()) : -1;
  if (at >= 0) {
    return {
      before: text.slice(0, at),
      hl: text.slice(at, at + word.length),
      after: text.slice(at + word.length),
    };
  }

  let best = { word: '', at: 0 };
  let cursor = 0;
  for (const chunk of text.split(/(\s+)/)) {
    if (chunk.trim().length > best.word.length) best = { word: chunk, at: cursor };
    cursor += chunk.length;
  }
  return {
    before: text.slice(0, best.at),
    hl: best.word,
    after: text.slice(best.at + best.word.length),
  };
}

const { before, hl, after } = splitHighlight(title, t(lang, 'hero_title_hl'));
---

<header class="hero section--paper grain" id="top" data-hero data-folio="01">
  <div class="container hero__grid grid">
    <div class="hero__text">
      <div class="hero__meta">
        <span class="tag">SPEC-01 / {t(lang, 'hero_badge')}</span>
        <span class="mono hero__folio">§ 01</span>
      </div>

      <h1 class="hero__title" data-hero-title>
        {before}<span class="hl-wrap"
          ><span class="hl" data-hero-highlight>{hl}</span>
          <svg
            class="hl-stroke"
            viewBox="0 0 220 18"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"
          >
            <path
              data-hero-stroke
              d="M3 13.4c32-5.2 62 1.4 99-2.2 31-3 63 3.6 115-2.2"></path>
          </svg>
        </span>{after}
      </h1>

      <p class="hero__lead" data-hero-lead>{t(lang, 'hero_subtitle')}</p>

      <div class="hero__actions" data-hero-actions>
        <a class="btn" href="#contact">{t(lang, 'hero_btn_1')}</a>
        <a class="btn btn--ghost" href="#join">{t(lang, 'hero_btn_2')}</a>
      </div>
    </div>

    <div class="hero__figure" data-hero-figure>
      <Molecule name="thc" class="hero__mol" data-hero-molecule />
      <div class="hero__portrait" data-hero-portrait>
        <span class="tape hero__tape" aria-hidden="true"></span>
        <Picture
          src={character}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[320, 480, 720]}
          sizes="(max-width: 55rem) 62vw, 26rem"
          alt=""
          loading="eager"
          decoding="async"
          class="hero__character"
        />
      </div>
      <p class="mono hero__caption" aria-hidden="true">Δ⁹-THC · C<sub>21</sub>H<sub>30</sub>O<sub>2</sub></p>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding-block: clamp(1.75rem, 3.5vw, 3rem) clamp(3rem, 6vw, 5.5rem);
  }

  .hero__grid {
    align-items: start;
    row-gap: var(--sp-xl);
  }

  .hero__text {
    grid-column: 1 / span 7;
    min-width: 0;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-s);
    margin-bottom: clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .hero__folio {
    color: var(--c-ink-faint);
  }

  .hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
    hyphens: auto;
    overflow-wrap: break-word;
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  /* ------------------------------------------------- Subrayado a rotulador */
  /* Sin JS se ve la banda de `.hl` (global.css). Con JS, Hero.ts la sustituye
     por este trazo, que se dibuja con DrawSVG. */
  .hl-wrap {
    position: relative;
    display: inline-block;
  }

  .hl-stroke {
    position: absolute;
    /* Con `left` + `right` el ancho saldría de la relación de aspecto del
       viewBox y el trazo se quedaría corto: se fija a mano el 100 % del texto. */
    left: -0.05em;
    bottom: 0.04em;
    width: calc(100% + 0.1em);
    height: 0.3em;
    overflow: visible;
    pointer-events: none;
    color: var(--c-marker);
  }

  .hl-stroke path {
    fill: none;
    stroke: currentColor;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ------------------------------------------------- Modo ligero (móvil) */
  /* Mismos gestos que en escritorio, resueltos con animaciones de CSS: nada de
     SplitText ni de DrawSVG, y ni un byte de GSAP. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-motion='lite']) .hero__title {
      animation: lite-rise 620ms var(--ease-out) 40ms both;
    }

    :global(html[data-motion='lite']) .hero__lead {
      animation: lite-rise 560ms var(--ease-out) 180ms both;
    }

    :global(html[data-motion='lite']) .hero__actions {
      animation: lite-rise 560ms var(--ease-out) 260ms both;
    }

    :global(html[data-motion='lite']) .hero__figure {
      animation: lite-pop 700ms var(--ease-out) 120ms both;
    }

    /* El subrayado se dibuja igual que en escritorio: trazo de `stroke-
       dashoffset` a cero, con la banda de rotulador sustituida por el SVG. */
    :global(html[data-motion='lite']) .hero__highlight-band,
    :global(html[data-motion='lite']) .hl {
      background-image: none;
    }

    :global(html[data-motion='lite']) .hl-stroke path {
      stroke-dasharray: 300;
      stroke-dashoffset: 300;
      animation: lite-draw 780ms var(--ease-out) 520ms forwards;
    }

    :global(html[data-motion='lite']) .hero__figure :global(.hero__mol) {
      animation: lite-breathe 4.2s ease-in-out 1.6s infinite alternate;
    }

    :global(html[data-motion='lite']) .hero__figure :global(.hero__mol path) {
      stroke-dasharray: 620;
      stroke-dashoffset: 620;
      animation: lite-draw 620ms linear forwards;
    }

    :global(html[data-motion='lite']) .hero__figure :global(.hero__mol path:nth-child(2)) {
      animation-delay: 60ms;
    }

    :global(html[data-motion='lite']) .hero__figure :global(.hero__mol path:nth-child(3)) {
      animation-delay: 120ms;
    }

    :global(html[data-motion='lite']) .hero__figure :global(.hero__mol path:nth-child(4)) {
      animation-delay: 180ms;
    }

    :global(html[data-motion='lite']) .hero__figure :global(.hero__mol path:nth-child(n + 5)) {
      animation-delay: 240ms;
    }

    :global(html[data-motion='lite']) .hero__figure :global(.hero__mol text) {
      animation: lite-rise 380ms ease-out 700ms both;
    }
  }

  /* Estado inicial del hero: lo fija el script inline de Base.astro sólo si
     hay JS y no se ha pedido menos movimiento. El estado final es el normal. */
  :global(html[data-motion='armed']) .hero__title,
  :global(html[data-motion='armed']) .hero__lead,
  :global(html[data-motion='armed']) .hero__actions,
  :global(html[data-motion='armed']) .hero__figure {
    opacity: 0;
  }

  .hero__lead {
    max-width: 42ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--c-ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-xs);
    margin-top: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  /* ------------------------------------------------------------- Figura */
  /* Personaje y molécula: dos piezas pegadas en la misma hoja. El dibujo de
     línea se apoya en la esquina superior del personaje. */
  .hero__figure {
    grid-column: 9 / span 4;
    position: relative;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .hero__portrait {
    position: relative;
    width: min(100%, 26rem);
    margin-left: auto;
  }

  .hero__character {
    width: 100%;
    height: auto;
    filter: drop-shadow(6px 6px 0 rgb(0 12 60 / 12%));
  }

  .hero__tape {
    top: -0.9rem;
    left: 50%;
    translate: -50% 0;
    rotate: -2.5deg;
  }

  /* Molécula de THC: dibujo de línea que se apoya en el personaje. */
  .hero__figure :global(.hero__mol) {
    align-self: flex-start;
    width: clamp(7.5rem, 11vw, 10.5rem);
    margin-left: -2rem;
    margin-bottom: -2.5rem;
    rotate: -6deg;
    color: var(--c-ink);
    opacity: 0.9;
    z-index: 1;
  }

  .hero__caption {
    margin-top: var(--sp-s);
    text-align: right;
    color: var(--c-ink-faint);
  }

  .hero__caption sub {
    font-size: 0.72em;
    line-height: 0;
  }

  @media (max-width: 68rem) {
    .hero__text {
      grid-column: 1 / span 8;
    }

    .hero__figure {
      grid-column: 9 / span 4;
    }
  }

  @media (max-width: 55rem) {
    .hero__text,
    .hero__figure {
      grid-column: 1 / -1;
    }

    .hero__figure {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: end;
      gap: var(--sp-s);
      max-width: 32rem;
    }

    .hero__portrait {
      grid-column: 2;
      width: 100%;
    }

    .hero__figure :global(.hero__mol) {
      grid-column: 1;
      width: 100%;
      margin-left: 0;
      margin-bottom: var(--sp-2xs);
      rotate: -4deg;
    }

    .hero__caption {
      display: none;
    }
  }
</style>
