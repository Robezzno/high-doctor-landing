---
import logoText from '../assets/brand/logo-text.svg';
import { showSection, socialLinks } from '../config/site';
import { languages, langPath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /**
   * Prefijo de los enlaces a secciones de la portada. En la home se queda vacío
   * (scroll en la misma página); en el blog apunta a la portada del idioma.
   */
  sectionBase?: string;
  /** Enlaces del selector de idioma a medida (para enlazar el mismo post traducido). */
  langHrefs?: Partial<Record<Lang, string>>;
  /** Sección activa, para `aria-current`. */
  current?: 'home' | 'news';
  /** Sombra dura fija: obligatorio fuera de la portada, donde no hay hero. */
  solid?: boolean;
}

const { lang, sectionBase = '', langHrefs, current = 'home', solid = false } = Astro.props;

/** Redes sociales: sólo con `sections.social` en true y enlaces reales de Saf. */
const showSocial = showSection('social');

/** Nombre de cada idioma en su propia lengua (para el desplegable). */
const langNames: Record<Lang, string> = {
  en: 'English',
  es: 'Español',
  de: 'Deutsch',
  fr: 'Français',
  it: 'Italiano',
  pt: 'Português',
  nl: 'Nederlands',
  pl: 'Polski',
};

/** El blog sólo existe en ES (`/noticias/`) y EN (`/en/news/`). */
const newsHref = lang === 'es' ? '/noticias/' : '/en/news/';
const section = (id: string) => `${sectionBase}#${id}`;

const navItems = [
  { href: section('mission'), label: t(lang, 'nav_mission'), num: '01' },
  { href: section('impact'), label: t(lang, 'nav_impact'), num: '02' },
  { href: section('join'), label: t(lang, 'nav_join'), num: '03' },
  { href: section('mary-jane'), label: t(lang, 'nav_maryjane'), num: '04' },
];
---

<header class:list={['nav', { 'nav--stuck': solid }]} data-nav>
  <div class="container nav__inner">
    <a class="nav__brand" href={langPath(lang)} aria-label="High Doctor Foundation">
      <img
        class="nav__logo"
        src={logoText.src}
        width={logoText.width}
        height={logoText.height}
        alt="High Doctor Foundation"
        loading="eager"
        decoding="async"
      />
    </a>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
      data-nav-toggle
    >
      <span class="mono nav__toggle-label">{t(lang, 'nav_menu')}</span>
      <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
    </button>

    <div class="nav__panel" id="nav-panel" data-nav-panel>
      <ul class="nav__links">
        {
          navItems.map((item) => (
            <li>
              <a class="nav__link" href={item.href}>
                <span class="nav__num mono" aria-hidden="true">
                  {item.num}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="nav__link"
            href={newsHref}
            aria-current={current === 'news' ? 'page' : undefined}
          >
            <span class="nav__num mono" aria-hidden="true">05</span>
            {t(lang, 'nav_news')}
          </a>
        </li>
        <li class="nav__cta">
          <a class="btn nav__btn" href={`${sectionBase}#contact`}>{t(lang, 'nav_cta')}</a>
        </li>
      </ul>

      <details class="langs">
        <summary class="langs__trigger mono">
          <span class="visually-hidden">{t(lang, 'ft_lang')}: </span>
          {lang}
          <span class="langs__caret" aria-hidden="true"></span>
        </summary>
        <ul class="langs__list">
          {
            languages.map((language) => (
              <li>
                <a
                  class="langs__option"
                  href={langHrefs?.[language] ?? langPath(language)}
                  hreflang={language}
                  lang={language}
                  aria-current={language === lang ? 'true' : undefined}
                >
                  <span class="mono langs__code">{language}</span>
                  {langNames[language]}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      {
        /* Redes sociales en la cabecera móvil; en escritorio viven en el footer. */
        showSocial && (
          <div class="nav__social">
            <span class="mono nav__social-title">{t(lang, 'social_follow')}</span>
            <ul class="nav__social-list">
              {socialLinks.map((link) => (
                <li>
                  <a
                    class="nav__social-link mono"
                    href={link.url}
                    rel="me noopener"
                    target="_blank"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: var(--c-paper);
    border-bottom: 1px solid var(--c-paper-3);
  }

  /* Sombra dura al despegarse: parece una hoja impresa sobre otra. */
  .nav--stuck {
    box-shadow: 0 2px 0 0 var(--c-ink);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-m);
    min-height: 4.5rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.35rem;
  }

  .nav__logo {
    height: clamp(1.9rem, 2.6vw, 2.5rem);
    width: auto;
  }

  .nav__panel {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.75rem);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.2vw, 1.35rem);
  }

  .nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    min-height: 44px;
    padding-block: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-ink-soft);
    border-bottom: 2px solid transparent;
    transition:
      color var(--dur-fast) linear,
      border-color var(--dur-fast) linear;
  }

  .nav__link:hover {
    color: var(--c-ink);
    border-bottom-color: var(--c-marker);
  }

  .nav__num {
    font-size: 0.62rem;
    color: var(--c-ink-faint);
  }

  .nav__btn {
    min-height: 44px;
    padding: 0.55rem 1rem;
  }

  /* -------------------------------------------------- Selector de idioma */
  .langs {
    position: relative;
  }

  .langs__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--c-paper-3);
    border-radius: var(--r-2);
    cursor: pointer;
    color: var(--c-ink-soft);
    list-style: none;
  }

  .langs__trigger::-webkit-details-marker {
    display: none;
  }

  .langs__caret {
    width: 0;
    height: 0;
    border-left: 3.5px solid transparent;
    border-right: 3.5px solid transparent;
    border-top: 4.5px solid currentColor;
  }

  .langs[open] .langs__trigger {
    border-color: var(--c-ink);
    color: var(--c-ink);
  }

  .langs__list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 12rem;
    padding: 0.35rem;
    background-color: var(--c-paper);
    border: 1px solid var(--c-ink);
    border-radius: var(--r-2);
    box-shadow: var(--shadow-2);
    z-index: var(--z-panel);
  }

  .langs__option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    color: var(--c-ink-soft);
    font-size: var(--fs-small);
    text-decoration: none;
    border-radius: var(--r-1);
  }

  .langs__option:hover {
    background-color: var(--c-paper-2);
    color: var(--c-ink);
  }

  .langs__option[aria-current='true'] {
    color: var(--c-ink);
    background-color: color-mix(in srgb, var(--c-marker) 45%, transparent);
  }

  .langs__code {
    font-size: 0.66rem;
    color: var(--c-ink-faint);
  }

  /* -------------------------------------------------- Redes (móvil) */
  /* En escritorio los enlaces sociales viven en el footer; aquí sólo se ven
     cuando el panel del menú está desplegado en móvil. */
  .nav__social {
    display: none;
  }

  .nav__social-title {
    color: var(--c-ink-faint);
    border-bottom: 1px solid var(--c-paper-3);
    padding-bottom: 0.45rem;
  }

  .nav__social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    padding-top: 0.45rem;
  }

  .nav__social-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-ink-soft);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .nav__social-link:hover {
    color: var(--c-ink);
    border-bottom-color: var(--c-marker);
  }

  /* ------------------------------------------------------ Botón móvil */
  .nav__toggle {
    display: none;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.4rem 0.5rem;
    background: none;
    border: 1px solid var(--c-paper-3);
    border-radius: var(--r-2);
    cursor: pointer;
    color: var(--c-ink);
  }

  .nav__bars {
    display: grid;
    gap: 4px;
    width: 18px;
  }

  .nav__bars i {
    display: block;
    height: 2px;
    background-color: currentColor;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .nav--open .nav__bars i:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .nav--open .nav__bars i:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 68rem) {
    .nav__toggle {
      display: inline-flex;
    }

    .nav__inner {
      flex-wrap: wrap;
    }

    .nav__panel {
      flex: 1 0 100%;
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-xs);
      order: 3;
    }

    /* Con JS el panel se abre y se cierra; sin JS queda siempre desplegado. */
    html.js .nav__panel {
      display: none;
    }

    .nav--open .nav__panel,
    html:not(.js) .nav__panel {
      display: flex;
      padding-block: var(--sp-s) var(--sp-m);
      /* En pantallas bajas el panel se desplaza solo: nunca deja enlaces
         inalcanzables por debajo del viewport. */
      max-height: calc(100svh - 4.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .nav__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__link {
      justify-content: flex-start;
      padding-block: 0.8rem;
      border-bottom: 1px solid var(--c-paper-3);
      font-size: var(--fs-mono-lg);
    }

    .nav__cta {
      padding-top: var(--sp-s);
    }

    .nav__btn {
      width: 100%;
    }

    .langs {
      padding-top: var(--sp-xs);
    }

    .langs__trigger {
      width: 100%;
      justify-content: space-between;
    }

    .langs__list {
      position: static;
      margin-top: 0.35rem;
      box-shadow: none;
    }

    .nav__social {
      display: grid;
      gap: 0.25rem;
      padding-top: var(--sp-xs);
    }
  }
</style>
