---
import logoText from '../assets/brand/logo-text.svg';
import { showSection, socialLinks } from '../config/site';
import { languages, langPath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /**
   * Prefijo de los enlaces a secciones de la portada. En la home se queda vacío
   * (scroll en la misma página); en el blog apunta a la portada del idioma.
   */
  sectionBase?: string;
  /** Enlaces del selector de idioma a medida (para enlazar el mismo post traducido). */
  langHrefs?: Partial<Record<Lang, string>>;
  /** Sección activa, para `aria-current`. */
  current?: 'home' | 'news';
  /** Compatibilidad: antes fijaba la sombra; la barra ya no lleva sombra. */
  solid?: boolean;
}

const { lang, sectionBase = '', langHrefs, current = 'home' } = Astro.props;

/** Redes sociales: sólo con `sections.social` en true y enlaces reales de Saf. */
const showSocial = showSection('social');

/** Nombre de cada idioma en su propia lengua (para el desplegable). */
const langNames: Record<Lang, string> = {
  en: 'English',
  es: 'Español',
  de: 'Deutsch',
  fr: 'Français',
  it: 'Italiano',
  pt: 'Português',
  nl: 'Nederlands',
  pl: 'Polski',
};

/** El blog sólo existe en ES (`/noticias/`) y EN (`/en/news/`). */
const newsHref = lang === 'es' ? '/noticias/' : '/en/news/';
const section = (id: string) => `${sectionBase}#${id}`;

const navItems = [
  { href: section('evidence'), label: t(lang, 'nav_evidence') },
  { href: section('about'), label: t(lang, 'v2_menu_about') },
  { href: section('mary-jane'), label: t(lang, 'nav_maryjane') },
];
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__tile nav__brand" href={langPath(lang)} aria-label="High Doctor Foundation">
      <img
        class="nav__logo"
        src={logoText.src}
        width={logoText.width}
        height={logoText.height}
        alt="High Doctor Foundation"
        loading="eager"
        decoding="async"
      />
    </a>

    <button
      class="nav__tile nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
      data-nav-toggle
    >
      <span class="nav__toggle-label">{t(lang, 'nav_menu')}</span>
      <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
    </button>

    <div class="nav__panel" id="nav-panel" data-nav-panel>
      <ul class="nav__tile nav__links">
        {
          navItems.map((item) => (
            <li>
              <a class="nav__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="nav__link"
            href={newsHref}
            aria-current={current === 'news' ? 'page' : undefined}
          >
            {t(lang, 'nav_news')}
          </a>
        </li>
      </ul>

      <details class="nav__tile langs">
        <summary class="langs__trigger">
          <span class="visually-hidden">{t(lang, 'ft_lang')}: </span>
          <span class="langs__current">{lang.toUpperCase()}</span>
          <span class="langs__caret" aria-hidden="true"></span>
        </summary>
        <ul class="langs__list">
          {
            languages.map((language) => (
              <li>
                <a
                  class="langs__option"
                  href={langHrefs?.[language] ?? langPath(language)}
                  hreflang={language}
                  lang={language}
                  aria-current={language === lang ? 'true' : undefined}
                >
                  {langNames[language]}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <a class="nav__tile nav__cta" href={`${sectionBase}#join`}>{t(lang, 'v2_menu_join')}</a>

      {
        showSocial && (
          <div class="nav__tile nav__social">
            <span class="nav__social-title">{t(lang, 'social_follow')}</span>
            <ul class="nav__social-list">
              {socialLinks.map((link) => (
                <li>
                  <a class="nav__social-link" href={link.url} rel="me noopener" target="_blank">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</header>

<style>
  /* Barra blanca fija: logotipo, cuatro enlaces, idioma y una acción. */
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: var(--c-white);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }

  .nav--stuck {
    box-shadow: 0 1px 0 var(--c-paper-3), 0 10px 24px -18px rgb(0 12 60 / 30%);
  }

  .nav__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: calc(var(--container) + 2 * var(--gutter));
    min-height: 72px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .nav__tile {
    display: flex;
    align-items: center;
  }

  .nav__brand {
    flex: 0 0 auto;
    min-height: 48px;
    margin-right: auto;
  }

  .nav__logo {
    height: 2.25rem;
    width: auto;
  }

  .nav__panel {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav__links {
    gap: 0.25rem;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.85rem;
    border-radius: var(--r-pill);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-fast) linear;
  }

  .nav__link:hover {
    background-color: var(--c-paper-2);
  }

  .nav__link[aria-current='page'] {
    background-color: var(--c-paper-3);
  }

  .nav__cta {
    min-height: 44px;
    padding-inline: 1.25rem;
    border-radius: var(--r-pill);
    background-color: var(--c-green);
    color: var(--c-ink);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-fast) linear,
      transform var(--dur-fast) var(--ease-out);
  }

  .nav__cta:hover {
    background-color: #00a338;
  }

  .nav__cta:active,
  .nav__toggle:active {
    transform: scale(0.97);
  }

  /* --------------------------------------------------------- Idiomas */
  .langs {
    position: relative;
  }

  .langs__trigger {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding-inline: 0.85rem;
    border-radius: var(--r-pill);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--dur-fast) linear;
  }

  .langs__trigger::-webkit-details-marker {
    display: none;
  }

  .langs__trigger:hover {
    background-color: var(--c-paper-2);
  }

  .langs__caret {
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .langs[open] .langs__caret {
    transform: translateY(2px) rotate(225deg);
  }

  .langs__list {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: var(--z-panel);
    min-width: 12rem;
    padding: 0.4rem;
    border-radius: var(--r-2);
    background-color: var(--c-white);
  }

  .langs[open] .langs__list {
    box-shadow: var(--shadow-2);
  }

  .langs__option {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.85rem;
    border-radius: var(--r-1);
    text-decoration: none;
    transition: background-color var(--dur-fast) linear;
  }

  .langs__option:hover {
    background-color: var(--c-paper-2);
  }

  .langs__option[aria-current='true'] {
    background-color: var(--c-paper-3);
    font-weight: 700;
  }

  /* --------------------------------------------------------- Móvil */
  .nav__toggle {
    display: none;
  }

  .nav__social {
    display: none;
  }

  @media (max-width: 60rem) {
    .nav__bar {
      flex-wrap: wrap;
      min-height: 64px;
      gap: 0.5rem;
    }

    .nav__logo {
      height: 2rem;
    }

    .nav__toggle {
      display: flex;
      gap: 0.6rem;
      min-height: 44px;
      padding-inline: 1rem;
      border: 0;
      border-radius: var(--r-pill);
      background-color: var(--c-paper-2);
      font-weight: 500;
      cursor: pointer;
    }

    .nav__bars {
      display: grid;
      gap: 5px;
      width: 1.2rem;
    }

    .nav__bars i {
      display: block;
      height: 2px;
      border-radius: 2px;
      background-color: currentColor;
      transition: transform var(--dur-base) var(--ease-out);
    }

    .nav--open .nav__bars i:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    .nav--open .nav__bars i:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }

    .nav__panel {
      flex: 1 0 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      padding-bottom: 1rem;
    }

    :global(html.js) .nav__panel {
      display: none;
    }

    :global(html.js) .nav--open .nav__panel {
      display: flex;
      max-height: calc(100svh - 72px);
      overflow-y: auto;
    }

    .nav__links {
      flex-direction: column;
      align-items: stretch;
    }

    .nav__link {
      min-height: 52px;
      font-size: 1.125rem;
    }

    .langs__list {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      padding: 0;
      box-shadow: none !important;
    }

    .nav__cta {
      justify-content: center;
      min-height: 52px;
    }

    .nav__social {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 0.5rem 0.85rem;
    }

    .nav__social-list {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__bars i,
    .langs__caret {
      transition: none;
    }
  }
</style>
