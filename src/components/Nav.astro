---
import logoText from '../assets/brand/logo-text.svg';
import { showSection, socialLinks } from '../config/site';
import { languages, langPath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /**
   * Prefijo de los enlaces a secciones de la portada. En la home se queda vacío
   * (scroll en la misma página); en el blog apunta a la portada del idioma.
   */
  sectionBase?: string;
  /** Enlaces del selector de idioma a medida (para enlazar el mismo post traducido). */
  langHrefs?: Partial<Record<Lang, string>>;
  /** Sección activa, para `aria-current`. */
  current?: 'home' | 'news';
  /** Compatibilidad: antes fijaba la sombra; la barra ya no lleva sombra. */
  solid?: boolean;
}

const { lang, sectionBase = '', langHrefs, current = 'home' } = Astro.props;

/** Redes sociales: sólo con `sections.social` en true y enlaces reales de Saf. */
const showSocial = showSection('social');

/** Nombre de cada idioma en su propia lengua (para el desplegable). */
const langNames: Record<Lang, string> = {
  en: 'English',
  es: 'Español',
  de: 'Deutsch',
  fr: 'Français',
  it: 'Italiano',
  pt: 'Português',
  nl: 'Nederlands',
  pl: 'Polski',
};

/** El blog sólo existe en ES (`/noticias/`) y EN (`/en/news/`). */
const newsHref = lang === 'es' ? '/noticias/' : '/en/news/';
const section = (id: string) => `${sectionBase}#${id}`;

const navItems = [
  { href: section('mission'), label: t(lang, 'nav_mission') },
  { href: section('evidence'), label: t(lang, 'nav_evidence') },
  { href: section('mary-jane'), label: t(lang, 'nav_maryjane') },
];
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__tile nav__brand" href={langPath(lang)} aria-label="High Doctor Foundation">
      <img
        class="nav__logo"
        src={logoText.src}
        width={logoText.width}
        height={logoText.height}
        alt="High Doctor Foundation"
        loading="eager"
        decoding="async"
      />
    </a>

    <button
      class="nav__tile nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
      data-nav-toggle
    >
      <span class="nav__toggle-label">{t(lang, 'nav_menu')}</span>
      <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
    </button>

    <div class="nav__panel" id="nav-panel" data-nav-panel>
      <ul class="nav__tile nav__links">
        {
          navItems.map((item) => (
            <li>
              <a class="nav__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="nav__link"
            href={newsHref}
            aria-current={current === 'news' ? 'page' : undefined}
          >
            {t(lang, 'nav_news')}
          </a>
        </li>
      </ul>

      <details class="nav__tile langs">
        <summary class="langs__trigger">
          <span class="visually-hidden">{t(lang, 'ft_lang')}: </span>
          <span class="langs__current">{lang.toUpperCase()}</span>
          <span class="langs__caret" aria-hidden="true"></span>
        </summary>
        <ul class="langs__list">
          {
            languages.map((language) => (
              <li>
                <a
                  class="langs__option"
                  href={langHrefs?.[language] ?? langPath(language)}
                  hreflang={language}
                  lang={language}
                  aria-current={language === lang ? 'true' : undefined}
                >
                  {langNames[language]}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <a class="nav__tile nav__cta" href={`${sectionBase}#contact`}>{t(lang, 'nav_cta')}</a>

      {
        showSocial && (
          <div class="nav__tile nav__social">
            <span class="nav__social-title">{t(lang, 'social_follow')}</span>
            <ul class="nav__social-list">
              {socialLinks.map((link) => (
                <li>
                  <a class="nav__social-link" href={link.url} rel="me noopener" target="_blank">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</header>

<style>
  /* Barra de baldosas: logo, enlaces, idioma y la única acción. Cada baldosa
     es un rectángulo relleno; los huecos de 8 px dejan ver la página. */
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    padding: 8px;
    background-color: var(--c-paper);
  }

  .nav__bar {
    display: flex;
    gap: 8px;
    min-height: 60px;
  }

  .nav__tile {
    display: flex;
    align-items: center;
    min-height: 60px;
    background-color: var(--c-paper-2);
    color: var(--c-ink);
  }

  .nav__brand {
    flex: 0 0 auto;
    padding-inline: max(1rem, calc(var(--margin) - 8px));
    transition: background-color var(--dur-fast) linear;
  }

  .nav__brand:hover {
    background-color: var(--c-paper-3);
  }

  .nav__logo {
    height: 2.1rem;
    width: auto;
  }

  .nav__panel {
    display: flex;
    flex: 1 1 auto;
    gap: 8px;
  }

  .nav__links {
    flex: 1 1 auto;
    gap: clamp(1rem, 2.4vw, 2.5rem);
    padding-inline: 1.5rem;
    /* Los enlaces empiezan en la línea central de la página. */
    padding-left: max(1.5rem, calc(50vw - 18rem));
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--step-body);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 3px;
    background-color: var(--c-green);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav__cta {
    flex: 0 0 auto;
    justify-content: center;
    padding-inline: 1.5rem;
    background-color: var(--c-ink);
    color: var(--c-paper);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-fast) linear,
      color var(--dur-fast) linear;
  }

  .nav__cta:hover {
    background-color: var(--c-green);
    color: var(--c-ink);
  }

  .nav__cta:active,
  .nav__toggle:active {
    transform: scale(0.98);
  }

  /* --------------------------------------------------------- Idiomas */
  .langs {
    position: relative;
    flex: 0 0 auto;
  }

  .langs__trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 60px;
    padding-inline: 1.15rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--dur-fast) linear;
  }

  .langs__trigger::-webkit-details-marker {
    display: none;
  }

  .langs__trigger:hover {
    background-color: var(--c-paper-3);
  }

  .langs__caret {
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .langs[open] .langs__caret {
    transform: translateY(2px) rotate(225deg);
  }

  .langs__list {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: var(--z-panel);
    min-width: 12rem;
    padding: 0.4rem;
    background-color: var(--c-ink);
  }

  /* Sólo flota (y sólo entonces lleva sombra) cuando está abierto. */
  .langs[open] .langs__list {
    box-shadow: var(--shadow-float);
  }

  .langs__option {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.85rem;
    color: var(--c-paper);
    text-decoration: none;
    transition: background-color var(--dur-fast) linear;
  }

  .langs__option:hover {
    background-color: var(--c-navy-2);
  }

  .langs__option[aria-current='true'] {
    background-color: var(--c-green);
    color: var(--c-ink);
    font-weight: 600;
  }

  /* --------------------------------------------------------- Móvil */
  .nav__toggle {
    display: none;
  }

  .nav__social {
    display: none;
  }

  @media (max-width: 64rem) {
    .nav {
      padding: 6px;
    }

    .nav__bar {
      flex-wrap: wrap;
      gap: 6px;
    }

    .nav__brand {
      flex: 1 1 auto;
    }

    .nav__toggle {
      display: flex;
      flex: 0 0 auto;
      gap: 0.75rem;
      padding-inline: 1.15rem;
      border: 0;
      background-color: var(--c-ink);
      color: var(--c-paper);
      font-weight: 600;
      cursor: pointer;
    }

    .nav__bars {
      display: grid;
      gap: 5px;
      width: 1.35rem;
    }

    .nav__bars i {
      display: block;
      height: 2px;
      background-color: currentColor;
      transition: transform var(--dur-base) var(--ease-out);
    }

    .nav--open .nav__bars i:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    .nav--open .nav__bars i:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }

    /* Con JS el panel se pliega; sin JS se queda desplegado y se lee entero. */
    .nav__panel {
      flex: 1 0 100%;
      flex-direction: column;
      gap: 6px;
    }

    :global(html.js) .nav__panel {
      display: none;
    }

    :global(html.js) .nav--open .nav__panel {
      display: flex;
      max-height: calc(100svh - 80px);
      overflow-y: auto;
    }

    .nav__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 1.15rem;
    }

    .nav__link {
      min-height: 52px;
      font-size: var(--step-lead);
    }

    .nav__link::after {
      bottom: 6px;
    }

    .langs__list {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      box-shadow: none;
    }

    .nav__cta {
      min-height: 60px;
    }

    .nav__social {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 1rem 1.15rem;
    }

    .nav__social-list {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__link::after,
    .nav__bars i,
    .langs__caret {
      transition: none;
    }
  }
</style>
