---
/**
 * Equipo (prompt 04, paso 3).
 *
 * Sólo se pinta con `sections.team` en `true` **y** al menos una persona real en
 * `teamMembers` (`src/config/site.ts`). Hoy está vacío y oculto: no se inventan
 * personas, cargos ni fotos. Cuando Saf pase los datos, basta con rellenar el
 * array y cambiar el flag.
 */
import { showSection, teamMembers } from '../config/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const visible = showSection('team');
---

{
  visible && (
    <section id="equipo" class="team section--paper grain">
      <div class="container">
        <header class="section__head">
          <span class="tag">SPEC-06 / {t(lang, 'team_title')}</span>
        </header>

        <h2 class="h2 team__title">{t(lang, 'team_title')}</h2>
        <p class="lead team__lead">{t(lang, 'team_lead')}</p>

        <ul class="team__list">
          {teamMembers.map((member) => (
            <li class="team__member">
              <div class="team__photo">
                {member.photo ? (
                  <img src={member.photo} alt={member.name} loading="lazy" decoding="async" />
                ) : (
                  <span class="team__initials mono" aria-hidden="true">
                    {member.name.slice(0, 1)}
                  </span>
                )}
              </div>
              <h3 class="team__name">
                {member.url ? (
                  <a href={member.url} rel="noopener">{member.name}</a>
                ) : (
                  member.name
                )}
              </h3>
              <p class="mono team__role">{member.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .team {
    padding-block: var(--sp-2xl);
  }

  .team__title {
    margin-bottom: var(--sp-xs);
  }

  .team__lead {
    max-width: 48ch;
    margin-bottom: var(--sp-l);
  }

  .team__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: var(--sp-m);
  }

  .team__member {
    min-width: 0;
  }

  /* Duotono verde/crema: la foto va en gris y el fondo verde hace de tinta. */
  .team__photo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: linear-gradient(170deg, var(--c-green-deep), var(--c-paper-2));
    border: 1.5px solid var(--c-ink);
    border-radius: var(--r-1);
    box-shadow: var(--shadow-1);
  }

  .team__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
  }

  .team__initials {
    font-size: 2rem;
    color: var(--c-paper-muted);
  }

  .team__name {
    margin-top: var(--sp-xs);
    font-size: 1.1rem;
  }

  .team__name a {
    color: var(--c-ink);
    text-decoration-color: var(--c-green-deep);
  }

  .team__role {
    color: var(--c-ink-faint);
    margin-top: 0.2rem;
  }
</style>
