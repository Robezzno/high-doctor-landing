---
import { contactEmail, showSection, socialLinks } from '../config/site';
import { credits } from '../data/credits';
import { legalPath } from '../data/legal';
import { languages, langPath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /**
   * Prefijo de los enlaces a secciones de la portada. En la home se queda vacío;
   * en el blog y en las páginas legales apunta a la portada del idioma.
   */
  sectionBase?: string;
}

const { lang, sectionBase = '' } = Astro.props;

const section = (id: string) => `${sectionBase}#${id}`;
const showSocial = showSection('social');
const newsHref = lang === 'es' ? '/noticias/' : '/en/news/';

const langNames: Record<Lang, string> = {
  en: 'English',
  es: 'Español',
  de: 'Deutsch',
  fr: 'Français',
  it: 'Italiano',
  pt: 'Português',
  nl: 'Nederlands',
  pl: 'Polski',
};

const navItems = [
  { href: section('evidence'), label: t(lang, 'nav_evidence') },
  { href: section('method'), label: t(lang, 'v2_scale_title') },
  { href: newsHref, label: t(lang, 'nav_news') },
  { href: section('about'), label: t(lang, 'v2_menu_about') },
  { href: section('mary-jane'), label: t(lang, 'nav_maryjane') },
  { href: section('join'), label: t(lang, 'v2_join_title') },
];

const legalItems = [
  { href: legalPath(lang, 'privacy'), label: t(lang, 'ft_privacy') },
  { href: legalPath(lang, 'notice'), label: t(lang, 'ft_notice') },
  { href: legalPath(lang, 'cookies'), label: t(lang, 'ft_cookies') },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <p class="footer__name">High Doctor Foundation</p>
      <p>{t(lang, 'ft_tagline')}</p>
      <a class="footer__mail" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      {
        showSocial && (
          <ul class="footer__social">
            {socialLinks.map((link) => (
              <li>
                <a href={link.url} rel="me noopener" target="_blank">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <nav class="footer__col" aria-labelledby="footer-nav-title">
      <h2 class="footer__title" id="footer-nav-title">{t(lang, 'ft_nav')}</h2>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer__col" aria-labelledby="footer-lang-title">
      <h2 class="footer__title" id="footer-lang-title">{t(lang, 'ft_lang')}</h2>
      <ul class="footer__langs">
        {
          languages.map((language) => (
            <li>
              <a
                href={langPath(language)}
                hreflang={language}
                lang={language}
                aria-current={language === lang ? 'true' : undefined}
              >
                {langNames[language]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__title">{t(lang, 'ft_legal')}</h2>
      <ul>
        {
          legalItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <p class="footer__disclaimer">{t(lang, 'evd_disclaimer')}</p>
    <details class="footer__credits">
      <summary>{t(lang, 'ft_credits')}</summary>
      <ul>
        {
          credits.map((credit) => (
            <li>
              <a href={credit.page} rel="noopener" target="_blank">
                {credit.title}
              </a>
              , {credit.creator},{' '}
              <a href={credit.licenseUrl} rel="noopener" target="_blank">
                {credit.license}
              </a>
              , Wikimedia Commons
            </li>
          ))
        }
      </ul>
    </details>
    <p>© {year} High Doctor Foundation · {t(lang, 'ft_rights')}</p>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(3rem, 2rem + 4vw, 5rem) 0 2rem;
    background-color: var(--c-ink);
    color: var(--c-white);
    --focus-color: var(--c-white);
  }

  .footer__inner,
  .footer__bottom {
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  .footer__brand {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    max-width: 24rem;
  }

  .footer__brand p {
    margin: 0;
    color: var(--c-paper-muted);
  }

  .footer__name {
    font-size: var(--fs-h3);
    font-weight: 800;
    color: var(--c-white) !important;
  }

  .footer__mail {
    justify-self: start;
    font-weight: 500;
    text-decoration-color: var(--c-green);
  }

  .footer__title {
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .footer__col ul {
    display: grid;
    gap: 0.5rem;
  }

  .footer__langs {
    grid-template-columns: repeat(2, auto);
    justify-content: start;
    column-gap: 1.25rem;
  }

  .footer__col a,
  .footer__social a {
    color: var(--c-paper-muted);
    text-decoration: none;
    transition: color var(--dur-fast) linear;
  }

  .footer__col a:hover,
  .footer__social a:hover {
    color: var(--c-white);
    text-decoration: underline;
    text-decoration-color: var(--c-green);
  }

  .footer__col a[aria-current='true'] {
    color: var(--c-white);
    font-weight: 700;
  }

  .footer__social {
    display: flex;
    gap: 1rem;
  }

  .footer__bottom {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 14%);
    font-size: var(--fs-small);
    color: var(--c-paper-muted);
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__disclaimer {
    max-width: var(--measure);
  }

  .footer__credits summary {
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer__credits ul {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .footer__credits a {
    color: inherit;
  }

  @media (max-width: 55rem) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
