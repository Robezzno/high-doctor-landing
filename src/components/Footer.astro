---
import logoText from '../assets/brand/logo-text.svg';
import { contactEmail, showSection, socialLinks } from '../config/site';
import { credits } from '../data/credits';
import { legalPath } from '../data/legal';
import { languages, langPath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /**
   * Prefijo de los enlaces a secciones de la portada. En la home se queda vacío;
   * en el blog y en las páginas legales apunta a la portada del idioma.
   */
  sectionBase?: string;
}

const { lang, sectionBase = '' } = Astro.props;

const section = (id: string) => `${sectionBase}#${id}`;

const showSocial = showSection('social');

const langNames: Record<Lang, string> = {
  en: 'English',
  es: 'Español',
  de: 'Deutsch',
  fr: 'Français',
  it: 'Italiano',
  pt: 'Português',
  nl: 'Nederlands',
  pl: 'Polski',
};

const navItems = [
  { href: section('mission'), label: t(lang, 'nav_mission') },
  { href: section('evidence'), label: t(lang, 'nav_evidence') },
  { href: section('impact'), label: t(lang, 'nav_impact') },
  { href: section('join'), label: t(lang, 'nav_join') },
  { href: section('mary-jane'), label: t(lang, 'nav_maryjane') },
];

const legalItems = [
  { href: legalPath(lang, 'privacy'), label: t(lang, 'ft_privacy') },
  { href: legalPath(lang, 'notice'), label: t(lang, 'ft_notice') },
  { href: legalPath(lang, 'cookies'), label: t(lang, 'ft_cookies') },
];

const [mailUser, mailDomain] = contactEmail.split('@');
const year = new Date().getFullYear();
---

<!-- El cierre: un campo entero del verde de la estrella y la forma de
     escribirnos como titular. -->
<footer class="footer">
  <div class="footer__top">
    <div class="footer__notes">
      <img
        class="footer__logo"
        src={logoText.src}
        width={logoText.width}
        height={logoText.height}
        alt="High Doctor Foundation"
        loading="lazy"
        decoding="async"
      />
      <p>{t(lang, 'ft_tagline')}</p>
      <p>{t(lang, 'ft_about_desc')}</p>
    </div>

    <nav class="footer__nav" aria-labelledby="footer-nav-title">
      <h2 class="visually-hidden" id="footer-nav-title">{t(lang, 'ft_nav')}</h2>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a class="link-draw" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer__nav" aria-labelledby="footer-lang-title">
      <h2 class="visually-hidden" id="footer-lang-title">{t(lang, 'ft_lang')}</h2>
      <ul>
        {
          languages.map((language) => (
            <li>
              <a
                class="link-draw"
                href={langPath(language)}
                hreflang={language}
                lang={language}
                aria-current={language === lang ? 'true' : undefined}
              >
                {langNames[language]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="footer__top-link link-bar" href="#top">{t(lang, 'ft_top')}</a>
  </div>

  <div class="footer__contact">
    <h2 class="visually-hidden">{t(lang, 'ft_write')}</h2>
    <a class="footer__mail" href={`mailto:${contactEmail}`}>
      <span>{mailUser}</span><span>@{mailDomain}</span>
    </a>
    {
      showSocial && (
        <ul class="footer__social">
          {socialLinks.map((link) => (
            <li>
              <a class="link-bar" href={link.url} rel="me noopener" target="_blank">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="footer__meta">
    <ul class="footer__legal">
      {
        legalItems.map((item) => (
          <li>
            <a class="link-draw" href={item.href}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="footer__credits">
      <summary>{t(lang, 'ft_credits')}</summary>
      <ul>
        {
          credits.map((credit) => (
            <li>
              <a href={credit.page} rel="noopener" target="_blank">
                {credit.title}
              </a>
              , {credit.creator}, <a href={credit.licenseUrl} rel="noopener" target="_blank">{credit.license}</a>, Wikimedia Commons
            </li>
          ))
        }
      </ul>
    </details>

    <p class="footer__year">© {year} High Doctor Foundation · {t(lang, 'ft_rights')}</p>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: 90svh;
    padding: 2.5rem var(--margin) 1.5rem;
    background-color: var(--c-green);
    color: var(--c-ink);
    --focus-color: var(--c-ink);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 5fr 2fr 2fr 2fr;
    gap: var(--grid-gap);
    align-items: start;
  }

  .footer__notes {
    display: grid;
    gap: 0.75rem;
    max-width: 44ch;
    font-size: var(--step-small);
    line-height: 1.45;
  }

  .footer__notes p {
    margin: 0;
  }

  .footer__logo {
    width: 9rem;
    height: auto;
    margin-bottom: 0.5rem;
  }

  .footer__nav ul {
    display: grid;
    gap: 0.35rem;
  }

  .footer__nav a {
    display: inline-block;
    padding-block: 0.2rem;
    font-size: var(--step-small);
    font-weight: 500;
    text-decoration: none;
  }

  .footer__nav a[aria-current='true'] {
    font-weight: 700;
  }

  .footer__top-link {
    justify-self: end;
    font-size: var(--step-small);
  }

  .footer__contact {
    display: grid;
    gap: 1.5rem;
  }

  .footer__mail {
    display: block;
    font-size: clamp(3rem, 1rem + 10vw, 12rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.05em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer__mail span {
    display: block;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .footer__mail:hover span:last-child {
    transform: translateX(0.12em);
  }

  .footer__mail:hover span:first-child {
    transform: translateX(-0.04em);
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer__meta {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem 2rem;
    align-items: start;
    font-size: var(--step-small);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }

  .footer__legal a {
    text-decoration: none;
    font-weight: 500;
  }

  .footer__credits summary {
    cursor: pointer;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .footer__credits ul {
    display: grid;
    gap: 0.4rem;
    max-width: 60ch;
    margin-top: 0.75rem;
  }

  .footer__year {
    justify-self: end;
    margin: 0;
    text-align: right;
  }

  @media (max-width: 55rem) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .footer__notes {
      grid-column: 1 / -1;
    }

    .footer__top-link {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .footer__mail {
      font-size: 12vw;
    }

    .footer__meta {
      grid-template-columns: 1fr;
      font-size: 0.8125rem;
    }

    .footer__year {
      justify-self: start;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__mail span {
      transition: none;
    }
  }
</style>
