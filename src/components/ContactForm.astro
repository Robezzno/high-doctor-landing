---
import { t, type Lang, type TranslationKey } from '../i18n';
import { legalPath } from '../data/legal';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const interestOptions: TranslationKey[] = [
  'form_opt_2',
  'form_opt_3',
  'form_opt_4',
  'form_opt_5',
  'form_opt_6',
  'form_opt_7',
  'form_opt_8',
];

// Los `value` no se traducen: son los que llegan por email a Web3Forms.
const interestValues = [
  'research',
  'medical',
  'education',
  'collaboration',
  'volunteering',
  'media',
  'other',
];
---

<form
  id="lead-form"
  class="form"
  action="https://api.web3forms.com/submit"
  method="POST"
  data-msg-sending={t(lang, 'form_sending')}
  data-msg-success={t(lang, 'form_success')}
  data-msg-error={t(lang, 'form_error')}
  data-btn-label={t(lang, 'form_btn')}
>
  <!-- Web3Forms config -->
  <input type="hidden" name="access_key" value="4abe23f2-0d49-48b0-83b5-fd372e6d6094" />
  <input type="hidden" name="subject" value="Nuevo Lead - High Doctor Foundation" />
  <input type="hidden" name="from_name" value="High Doctor Foundation" />
  <input type="hidden" name="redirect" value="https://highdoctor.foundation" />
  <input type="checkbox" name="botcheck" id="botcheck" style="display:none;" tabindex="-1" />

  <div class="fields">
    <div class="field">
      <label for="name">{t(lang, 'form_lbl_name')}</label>
      <input type="text" id="name" name="name" required autocomplete="name" placeholder="Dr. Jane Doe" />
    </div>

    <div class="field">
      <label for="email">{t(lang, 'form_lbl_email')}</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="jane.doe@example.com"
      />
    </div>

    <div class="field">
      <label for="country">{t(lang, 'form_lbl_country')}</label>
      <input
        type="text"
        id="country"
        name="country"
        required
        autocomplete="country-name"
        placeholder="e.g. Germany"
      />
    </div>

    <div class="field">
      <label for="organization">{t(lang, 'form_lbl_org')}</label>
      <input
        type="text"
        id="organization"
        name="organization"
        autocomplete="organization"
        placeholder="University, Clinic, Company..."
      />
    </div>

    <div class="field">
      <label for="profession">{t(lang, 'form_lbl_prof')}</label>
      <input
        type="text"
        id="profession"
        name="profession"
        required
        placeholder="e.g. Researcher, Doctor..."
      />
    </div>

    <div class="field">
      <label for="interest">{t(lang, 'form_lbl_int')}</label>
      <select id="interest" name="interest" required>
        <option value="" disabled selected>{t(lang, 'form_opt_1')}</option>
        {
          interestOptions.map((key, index) => (
            <option value={interestValues[index]}>{t(lang, key)}</option>
          ))
        }
      </select>
    </div>

    <div class="field field--full">
      <label for="linkedin">{t(lang, 'form_lbl_li')}</label>
      <input type="url" id="linkedin" name="linkedin" placeholder="https://linkedin.com/in/..." />
    </div>

    <div class="field field--full">
      <label for="message">{t(lang, 'form_lbl_msg')}</label>
      <textarea
        id="message"
        name="message"
        rows="4"
        placeholder="Briefly describe your background or proposal..."></textarea>
    </div>
  </div>

  <div class="consent">
    <label class="check" for="updates">
      <input type="checkbox" id="updates" name="updates" checked />
      <span>{t(lang, 'form_lbl_check')}</span>
    </label>

    <label class="check" for="privacy-consent">
      <input
        type="checkbox"
        id="privacy-consent"
        name="privacy_consent"
        value="accepted"
        required
      />
      <!-- El enlace va a la política de privacidad real del idioma de la página. -->
      <span>
        {t(lang, 'form_consent_pre')}<a href={legalPath(lang, 'privacy')}
          >{t(lang, 'form_consent_link')}</a
        >{t(lang, 'form_consent_post')}
      </span>
    </label>
  </div>

  <div class="form__foot">
    <button type="submit" class="btn btn--accent form__submit">
      {t(lang, 'form_btn')}
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M2 9h12M10 4l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2"></path>
      </svg>
    </button>
    <p class="form__req">{t(lang, 'form_required_note')}</p>
  </div>

  <div
    id="form-status"
    class="form-status hidden"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
  </div>
</form>

<style>
  .form {
    display: grid;
    gap: var(--sp-l);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-m) var(--grid-gap);
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  label {
    font-size: var(--step-small);
    font-weight: 600;
  }

  /* Campos de formulario: las líneas aquí son legítimas (es un formulario). */
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 0.8rem 0.95rem;
    border: 0;
    border-bottom: 2px solid var(--c-ink);
    border-radius: 0;
    background-color: var(--c-paper);
    font-size: var(--step-body);
    transition:
      background-color var(--dur-fast) linear,
      border-color var(--dur-fast) linear;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--c-ink-faint);
  }

  input:hover,
  select:hover,
  textarea:hover {
    background-color: #fff;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--c-green);
    outline-offset: 0;
    background-color: #fff;
  }

  input:user-invalid,
  select:user-invalid {
    border-bottom-color: var(--c-danger);
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .consent {
    display: grid;
    gap: var(--sp-s);
  }

  .check {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.75rem;
    align-items: start;
    font-size: var(--step-small);
    font-weight: 400;
    line-height: 1.45;
    cursor: pointer;
  }

  .check input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.1rem 0 0;
    accent-color: var(--c-ink);
  }

  .check a {
    font-weight: 600;
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-s) var(--sp-m);
  }

  .form__submit {
    min-height: 60px;
    padding-inline: 2rem;
  }

  .form__req {
    margin: 0;
    font-size: var(--step-small);
    color: var(--c-ink-soft);
  }

  .form-status {
    padding: 1rem 1.25rem;
    font-weight: 500;
  }

  .form-status--pending {
    background-color: var(--c-paper-3);
  }

  .form-status--success {
    background-color: var(--c-success-bg);
    color: var(--c-success);
  }

  .form-status--error {
    background-color: var(--c-danger-bg);
    color: var(--c-danger);
  }

  @media (max-width: 40rem) {
    .fields {
      grid-template-columns: 1fr;
    }

    .form__submit {
      width: 100%;
    }
  }
</style>
