---
// Autoalojado: ni Google Fonts ni CDNs de terceros. Sólo el eje de peso (wght)
// de cada familia, en sus subsets latino y latino-extendido (por el polaco);
// el navegador descarga sólo el subset que necesita cada página.
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
// Los dos ficheros que se usan por encima del pliegue (titular y texto) se
// precargan: así el cambio de tipografía no mueve la página al cargar.
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import frauncesLatinExt from '@fontsource-variable/fraunces/files/fraunces-latin-ext-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter-tight/files/inter-tight-latin-ext-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/blog.css';
import { languages, langPath, t, type Lang } from '../i18n';

interface Alternate {
  lang: string;
  href: string;
}

interface Props {
  /** Idioma de la página. */
  lang: Lang;
  /** Sólo en `/`: redirige una vez según el idioma del navegador. */
  redirectBrowserLang?: boolean;
  /** Título de la pestaña y `og:title`. Por defecto, el de la home. */
  title?: string;
  /** `meta description` y `og:description`. */
  description?: string;
  /** Imagen social (ruta del sitio o URL absoluta). */
  image?: string;
  /** `og:type`. */
  type?: 'website' | 'article';
  /** `hreflang` a medida. El blog sólo existe en ES y EN. */
  alternates?: Alternate[];
  /** Feed RSS del idioma, para el autodescubrimiento. */
  rss?: string;
  /** `article:published_time` (ISO) en los posts. */
  publishedTime?: string;
}

const {
  lang,
  redirectBrowserLang = false,
  title: customTitle,
  description: customDescription,
  image,
  type = 'website',
  alternates: customAlternates,
  rss,
  publishedTime,
} = Astro.props;

// Sólo el polaco necesita el subset latino-extendido en la primera pantalla
// (ą, ł, ż…); el resto de idiomas tira de latin. El alemán usa latin (ä, ö, ü, ß).
const criticalFonts =
  lang === 'pl' ? [frauncesLatin, frauncesLatinExt, interLatin, interLatinExt] : [frauncesLatin, interLatin];

// Mismo <title> y misma descripción que la web antigua (los textos SEO
// por idioma llegan en el prompt 09).
const siteName = 'High Doctor Foundation';
const defaultTitle = `${siteName} | Advancing Cannabis Knowledge`;
// En el blog el título del post manda y el nombre del sitio se añade al final,
// sin duplicarlo cuando el título del post ya lo incluye.
const title = customTitle
  ? customTitle.includes(siteName)
    ? customTitle
    : `${customTitle} | ${siteName}`
  : defaultTitle;
const ogTitle = customTitle ?? defaultTitle;
const description =
  customDescription ??
  'High Doctor Foundation is an independent non-profit organization dedicated to education, culture, community development and social awareness regarding cannabis and cannabinoids.';

const site = Astro.site ?? new URL('https://highdoctor.foundation');
const canonical = new URL(Astro.url.pathname, site);
const absolute = (path: string) => new URL(path, site).href;

const alternates: Alternate[] =
  customAlternates ??
  languages.map((language) => ({
    lang: language,
    href: absolute(langPath(language)),
  }));

const imageUrl = image ? absolute(image) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
      ))
    }
    {
      // En el blog el x-default apunta a la versión EN, no a la portada.
      !alternates.some((alternate) => alternate.lang === 'x-default') && (
        <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
      )
    }
    {rss && <link rel="alternate" type="application/rss+xml" title={ogTitle} href={absolute(rss)} />}

    <!-- Open Graph y Twitter: la imagen la genera el build (Satori + resvg + sharp). -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={ogTitle} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <!-- Favicon y manifest de la marca (estrella verde sobre azul marino). -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F4EFE4" />

    {
      criticalFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
      ))
    }

    <!-- Marca de "hay JavaScript" para que el contenido nunca dependa de él:
         sin JS, nada se oculta y el menú móvil se muestra desplegado.
         `data-astro-rerun` la vuelve a ejecutar en cada navegación con el
         router, porque el intercambio de documento borra los atributos de
         <html>. El temporizador de seguridad levanta el estado inicial si el
         paquete de animación no llega a arrancar: el texto se lee siempre. -->
    <script is:inline data-astro-rerun>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var wide = window.matchMedia('(min-width: 55.01rem)').matches;
          var connection = navigator.connection;
          var saving = connection && connection.saveData === true;
          // Sólo se oculta el hero en escritorio, donde la entrada por líneas
          // necesita reservar el sitio. En móvil la entrada es un `transform`.
          if (!reduce && !saving && wide) {
            root.dataset.motion = 'armed';
            setTimeout(function () {
              if (root.dataset.motion === 'armed') root.dataset.motion = 'failed';
            }, 2500);
          }
        } catch (error) {
          /* Sin matchMedia: se queda el estado final del CSS, que es legible. */
        }
      })();
    </script>

    {
      redirectBrowserLang && (
        <script is:inline>
          // Primera visita a `/`: si el navegador está en otro idioma soportado,
          // se redirige una sola vez y se guarda la preferencia. Nunca bloquea la carga.
          // No lleva `data-astro-rerun`: sólo debe decidir en una carga completa,
          // no al volver a `/` desde el blog con el router.
          (function () {
            try {
              if (localStorage.getItem('preferredLang')) return;
              var supported = ['es', 'de', 'fr', 'it', 'pt', 'nl', 'pl'];
              var lang = (navigator.language || '').slice(0, 2).toLowerCase();
              if (supported.indexOf(lang) === -1) {
                localStorage.setItem('preferredLang', 'en');
                return;
              }
              localStorage.setItem('preferredLang', lang);
              window.location.replace('/' + lang + '/');
            } catch (e) {
              /* Sin localStorage (modo privado, cookies bloqueadas): se queda en EN. */
            }
          })();
        </script>
      )
    }

    <!-- Transiciones entre páginas: portada ↔ blog ↔ noticia con View
         Transitions. `fallback` cubre navegadores sin la API nativa. -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'a11y_skip')}</a>
    <slot />

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
