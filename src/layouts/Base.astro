---
import '../styles/global.css';
import '../styles/blog.css';
import { languages, langPath, type Lang } from '../i18n';

interface Alternate {
  lang: string;
  href: string;
}

interface Props {
  /** Idioma de la página. */
  lang: Lang;
  /** Sólo en `/`: redirige una vez según el idioma del navegador. */
  redirectBrowserLang?: boolean;
  /** Título de la pestaña y `og:title`. Por defecto, el de la home. */
  title?: string;
  /** `meta description` y `og:description`. */
  description?: string;
  /** Imagen social (ruta del sitio o URL absoluta). */
  image?: string;
  /** `og:type`. */
  type?: 'website' | 'article';
  /** `hreflang` a medida. El blog sólo existe en ES y EN. */
  alternates?: Alternate[];
  /** Feed RSS del idioma, para el autodescubrimiento. */
  rss?: string;
  /** `article:published_time` (ISO) en los posts. */
  publishedTime?: string;
}

const {
  lang,
  redirectBrowserLang = false,
  title: customTitle,
  description: customDescription,
  image,
  type = 'website',
  alternates: customAlternates,
  rss,
  publishedTime,
} = Astro.props;

// Mismo <title> y misma descripción que la web antigua (los textos SEO
// por idioma llegan en el prompt 09).
const siteName = 'High Doctor Foundation';
const defaultTitle = `${siteName} | Advancing Cannabis Knowledge`;
// En el blog el título del post manda y el nombre del sitio se añade al final,
// sin duplicarlo cuando el título del post ya lo incluye.
const title = customTitle
  ? customTitle.includes(siteName)
    ? customTitle
    : `${customTitle} | ${siteName}`
  : defaultTitle;
const ogTitle = customTitle ?? defaultTitle;
const description =
  customDescription ??
  'High Doctor Foundation is an independent non-profit organization dedicated to education, culture, community development and social awareness regarding cannabis and cannabinoids.';

const site = Astro.site ?? new URL('https://highdoctor.foundation');
const canonical = new URL(Astro.url.pathname, site);
const absolute = (path: string) => new URL(path, site).href;

const alternates: Alternate[] =
  customAlternates ??
  languages.map((language) => ({
    lang: language,
    href: absolute(langPath(language)),
  }));

const imageUrl = image ? absolute(image) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
      ))
    }
    {
      // En el blog el x-default apunta a la versión EN, no a la portada.
      !alternates.some((alternate) => alternate.lang === 'x-default') && (
        <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
      )
    }
    {rss && <link rel="alternate" type="application/rss+xml" title={title} href={absolute(rss)} />}

    <!-- Open Graph y Twitter: la imagen la genera el build (Satori + resvg + sharp). -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={ogTitle} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <!-- Tipografías: igual que la web antigua, mismas familias y pesos. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {
      redirectBrowserLang && (
        <script is:inline>
          // Primera visita a `/`: si el navegador está en otro idioma soportado,
          // se redirige una sola vez y se guarda la preferencia. Nunca bloquea la carga.
          (function () {
            try {
              if (localStorage.getItem('preferredLang')) return;
              var supported = ['es', 'de', 'fr', 'it', 'pt', 'nl', 'pl'];
              var lang = (navigator.language || '').slice(0, 2).toLowerCase();
              if (supported.indexOf(lang) === -1) {
                localStorage.setItem('preferredLang', 'en');
                return;
              }
              localStorage.setItem('preferredLang', lang);
              window.location.replace('/' + lang + '/');
            } catch (e) {
              /* Sin localStorage (modo privado, cookies bloqueadas): se queda en EN. */
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <slot />

    <!-- vanilla-tilt sigue viniendo del CDN, como en la web antigua. -->
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"
    ></script>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
