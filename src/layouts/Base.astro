---
// Autoalojado: ni Google Fonts ni CDNs de terceros. Sólo el eje de peso (wght)
// de cada familia, en sus subsets latino y latino-extendido (por el polaco);
// el navegador descarga sólo el subset que necesita cada página.
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
// Los dos ficheros que se usan por encima del pliegue (titular y texto) se
// precargan: así el cambio de tipografía no mueve la página al cargar.
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import frauncesLatinExt from '@fontsource-variable/fraunces/files/fraunces-latin-ext-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter-tight/files/inter-tight-latin-ext-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import { languages, langPath, t, type Lang } from '../i18n';

interface Props {
  /** Idioma de la página. */
  lang: Lang;
  /** Sólo en `/`: redirige una vez según el idioma del navegador. */
  redirectBrowserLang?: boolean;
}

const { lang, redirectBrowserLang = false } = Astro.props;

// Sólo el polaco necesita el subset latino-extendido en la primera pantalla
// (ą, ł, ż…); el resto de idiomas tira de latin. El alemán usa latin (ä, ö, ü, ß).
const criticalFonts =
  lang === 'pl' ? [frauncesLatin, frauncesLatinExt, interLatin, interLatinExt] : [frauncesLatin, interLatin];

// Mismo <title> y misma descripción que la web antigua (los textos SEO
// por idioma llegan en el prompt 09).
const title = 'High Doctor Foundation | Advancing Cannabis Knowledge';
const description =
  'High Doctor Foundation is an independent non-profit organization dedicated to education, culture, community development and social awareness regarding cannabis and cannabinoids.';

const site = Astro.site ?? new URL('https://highdoctor.foundation');
const canonical = new URL(Astro.url.pathname, site);
const alternates = languages.map((language) => ({
  lang: language,
  href: new URL(langPath(language), site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />

    <!-- Favicon y manifest de la marca (estrella verde sobre azul marino). -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F4EFE4" />

    {
      criticalFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
      ))
    }

    <!-- Marca de "hay JavaScript" para que el contenido nunca dependa de él:
         sin JS, nada se oculta y el menú móvil se muestra desplegado. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {
      redirectBrowserLang && (
        <script is:inline>
          // Primera visita a `/`: si el navegador está en otro idioma soportado,
          // se redirige una sola vez y se guarda la preferencia. Nunca bloquea la carga.
          (function () {
            try {
              if (localStorage.getItem('preferredLang')) return;
              var supported = ['es', 'de', 'fr', 'it', 'pt', 'nl', 'pl'];
              var lang = (navigator.language || '').slice(0, 2).toLowerCase();
              if (supported.indexOf(lang) === -1) {
                localStorage.setItem('preferredLang', 'en');
                return;
              }
              localStorage.setItem('preferredLang', lang);
              window.location.replace('/' + lang + '/');
            } catch (e) {
              /* Sin localStorage (modo privado, cookies bloqueadas): se queda en EN. */
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'a11y_skip')}</a>
    <slot />

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
