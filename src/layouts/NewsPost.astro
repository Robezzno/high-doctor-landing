---
import { Image } from 'astro:assets';

import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import PostCard from '../components/news/PostCard.astro';
import { render } from 'astro:content';
import { blogT } from '../i18n/blog';
import {
  authorLabel,
  blogBase,
  categoryLabel,
  categoryUrl,
  formatDate,
  getRelated,
  getTranslation,
  isoDate,
  ogImagePath,
  postUrl,
  rssUrl,
  slugOf,
  socialCardPath,
  type NewsEntry,
} from '../lib/news';
import type { Lang } from '../i18n';

interface Props {
  entry: NewsEntry;
}

const { entry } = Astro.props;
const lang = entry.data.lang;
const strings = blogT(lang);
const slug = slugOf(entry);
const url = postUrl(lang, slug);

const { Content } = await render(entry);

const translation = await getTranslation(entry);
const related = await getRelated(entry, 3);

const site = Astro.site ?? new URL('https://highdoctor.foundation');
const absoluteUrl = new URL(url, site).href;
const shareText = encodeURIComponent(entry.data.title);
const shareUrl = encodeURIComponent(absoluteUrl);

const shareLinks = [
  { label: 'X', href: `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}` },
  {
    label: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
  },
  { label: 'WhatsApp', href: `https://api.whatsapp.com/send?text=${shareText}%20${shareUrl}` },
  { label: 'Telegram', href: `https://t.me/share/url?url=${shareUrl}&text=${shareText}` },
  { label: 'Email', href: `mailto:?subject=${shareText}&body=${shareUrl}` },
];

/** Tiempo de lectura aproximado (200 palabras por minuto). */
const words = (entry.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 200));

const isHealth = entry.data.category === 'salud';

const alternates = translation
  ? [
      {
        lang: translation.data.lang,
        href: new URL(postUrl(translation.data.lang, slugOf(translation)), site).href,
      },
      { lang, href: absoluteUrl },
      {
        lang: 'x-default',
        href: new URL(postUrl(translation.data.lang, slugOf(translation)), site).href,
      },
    ]
  : [
      { lang, href: absoluteUrl },
      { lang: 'x-default', href: absoluteUrl },
    ];

const langHrefs = {
  es: lang === 'es' ? url : translation ? postUrl('es', slugOf(translation)) : blogBase('es'),
  en: lang === 'en' ? url : translation ? postUrl('en', slugOf(translation)) : blogBase('en'),
} as Partial<Record<Lang, string>>;
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  image={ogImagePath(lang, slug)}
  type="article"
  publishedTime={entry.data.date.toISOString()}
  alternates={alternates}
  rss={rssUrl(lang)}
>
  <Nav
    lang={lang}
    solid
    current="news"
    sectionBase={lang === 'es' ? '/es/' : '/'}
    langHrefs={langHrefs}
  />

  <main class="blog">
    <article class="blog-wrap blog-wrap--narrow">
      <header class="post-header">
        <a class="blog-eyebrow" href={categoryUrl(lang, entry.data.category)}>
          {categoryLabel(lang, entry.data.category)}
        </a>
        <h1 class="post-title" transition:name={`post-title-${slug}`}>{entry.data.title}</h1>
        <p class="post-summary">{entry.data.summary}</p>
        <div class="post-meta">
          <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date, lang)}</time>
          <span>{authorLabel(lang, entry.data.author)}</span>
          <span>{readingMinutes} min</span>
          {
            translation && (
              <a href={postUrl(translation.data.lang, slugOf(translation))} hreflang={translation.data.lang}>
                {strings.otherLanguage}
              </a>
            )
          }
        </div>
      </header>

      <figure class="post-cover">
        {
          entry.data.cover ? (
            <Image
              src={entry.data.cover}
              alt={entry.data.coverAlt ?? entry.data.title}
              widths={[480, 760, 1080]}
              sizes="(max-width: 760px) 100vw, 760px"
              loading="eager"
              transition:name={`post-cover-${slug}`}
            />
          ) : (
            <img
              src={socialCardPath(lang, slug)}
              alt={entry.data.coverAlt ?? entry.data.title}
              width="1080"
              height="1350"
              loading="eager"
              fetchpriority="high"
              transition:name={`post-cover-${slug}`}
            />
          )
        }
        <figcaption>
          {strings.featuredLabel} · High Doctor Foundation · {formatDate(entry.data.date, lang)}
        </figcaption>
      </figure>

      {isHealth && (
        <div class="callout callout--health" role="note">
          {strings.healthNotice}
        </div>
      )}

      <div class="post-body">
        <Content />
      </div>

      <div class="post-aside">
        {
          entry.data.source && (
            <div class="callout callout--source">
              <span class="callout__label">{strings.sourceTitle}</span>
              <p>
                <a href={entry.data.source.url} rel="noopener noreferrer nofollow" target="_blank">
                  {entry.data.source.name}
                </a>
              </p>
              <span class="callout__hint">{strings.sourceHint}</span>
            </div>
          )
        }

        <div class="share">
          <p class="share__title">{strings.shareTitle}</p>
          <div class="share__links">
            {
              shareLinks.map((link) => (
                <a class="chip" href={link.href} rel="noopener noreferrer" target="_blank">
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>

        <nav class="post-nav" aria-label={strings.newsTitle}>
          <a href={blogBase(lang)}>← {strings.backToBlog}</a>
          {translation && (
            <a href={postUrl(translation.data.lang, slugOf(translation))} hreflang={translation.data.lang}>
              {strings.otherLanguage}
            </a>
          )}
        </nav>
      </div>
    </article>

    {
      related.posts.length > 0 && (
        <section class="blog-wrap related" aria-labelledby="related-title">
          <h2 class="related__title" id="related-title">
            {related.isFallback ? strings.relatedFallbackTitle : strings.relatedTitle}
          </h2>
          <div class="post-list">
            {related.posts.map((post) => (
              <PostCard entry={post} lang={lang} />
            ))}
          </div>
        </section>
      )
    }
  </main>

  <Footer lang={lang} />
</Base>
